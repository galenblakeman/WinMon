<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(StoreBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);WINMON_STORE</DefineConstants>
    <!-- Matches WinMon's Store TFM, which adds the Windows Runtime projection. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/WinMon/WinMon.csproj" />
    <ProjectReference Include="../WinMon.AppExitHost/WinMon.AppExitHost.csproj" />
    <Compile Include="../Shared/ToolInstallationDetectionTestsBase.cs" Link="Shared/ToolInstallationDetectionTestsBase.cs" />
    <Compile Include="../Shared/NetworkSetupReplyCharacterizationTests.cs" Link="Shared/NetworkSetupReplyCharacterizationTests.cs" />
    <Compile Include="../Shared/NetworkSetupAvailabilityCharacterizationTests.cs" Link="Shared/NetworkSetupAvailabilityCharacterizationTests.cs" />
    <Compile Include="../Shared/NetworkSetupExtractionCharacterizationTests.cs" Link="Shared/NetworkSetupExtractionCharacterizationTests.cs" Condition="'$(StoreBuild)' != 'true'" />
    <Compile Include="../Shared/HardwareLabelCharacterizationTests.cs" Link="Shared/HardwareLabelCharacterizationTests.cs" />
    <Compile Include="../Shared/HardwareDetailsCharacterizationTests.cs" Link="Shared/HardwareDetailsCharacterizationTests.cs" />
    <Compile Include="../Shared/ConnectionStateCharacterizationTestsBase.cs" Link="Shared/ConnectionStateCharacterizationTestsBase.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/WinMon/App.xaml" Link="Fixtures/DiagnosticPins/App.xaml.xml"
          TargetPath="Fixtures/DiagnosticPins/App.xaml.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
