<DrawingImage xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <DrawingImage.Drawing>
        <DrawingGroup>
            <!-- Fix the view box so all sizes retain the same transparent margin. -->
            <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 256,0 256,256 0,256 Z"/>
            <GeometryDrawing Geometry="M 48,8 L 208,8 Q 248,8 248,48 L 248,208 Q 248,248 208,248 L 48,248 Q 8,248 8,208 L 8,48 Q 8,8 48,8 Z">
