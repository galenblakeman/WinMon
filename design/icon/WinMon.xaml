                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2C333C" Offset="0"/>
                        <GradientStop Color="#12171C" Offset="1"/>
                    </LinearGradientBrush>
                </GeometryDrawing.Brush>
                <GeometryDrawing.Pen><Pen Brush="#414B56" Thickness="2"/></GeometryDrawing.Pen>
            </GeometryDrawing>
            <!-- A single open waveform forms W; no fine detail or glow to blur at tray sizes. -->
            <GeometryDrawing Geometry="M 30,151 L 65,151 L 82,106 L 108,188 L 132,132 L 156,188 L 188,74 L 211,151 L 226,151">
                <GeometryDrawing.Pen><Pen Brush="#53F56A" Thickness="14" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage.Drawing>
</DrawingImage>
