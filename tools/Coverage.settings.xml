<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/](MonCore|MonCore\.Windows|WinMon|WinMon\.Cli|WinMon\.Mcp|WinMon\.NetworkService|WinMon\.NetworkSetup|WinMon\.NetworkProbe)\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <Sources>
      <Exclude>
        <Source>.*[\\/]obj[\\/].*</Source>
        <Source>.*[\\/]Strings\.Designer\.cs$</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
