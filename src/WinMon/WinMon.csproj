<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <NeutralLanguage>en</NeutralLanguage>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/WinMon.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyTitle>WinMon</AssemblyTitle>
    <Description>Lightweight Windows resource monitor</Description>
    <UpdatePublicKeyPath Condition="'$(UpdatePublicKeyPath)' == ''">Updates/update-public-key.pem</UpdatePublicKeyPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Compressed assemblies are inflated into private memory instead of mapped from the file: about +130 MiB
         working set and +80 MiB private, and slower startup, to save about 90 MB on disk. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Optimize>true</Optimize>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(StoreBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);WINMON_STORE</DefineConstants>
    <!-- Packages start at sign-in through the Windows Runtime StartupTask API, which this TFM projects. Its version
         is the package's MinVersion. Projects that reference WinMon set the same TFM for Store builds. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- Workstation GC sizes the gen0 budget from the L3 cache, up to 48 MiB on large-cache CPUs. WinMon allocates
         about 1 MB/s, so it commits the whole budget between rare collections. A 6 MiB cap cut private bytes from
         86 to 52 MiB in a 60 s profile, for about 16 cheap gen0 collections a minute. GCgen0size can only be set
         from the environment; this is the runtimeconfig form, confirmed with GC.GetConfigurationVariables. -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="6291456" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(UpdatePublicKeyPath)" LogicalName="WinMon.UpdatePublicKey" Condition="Exists('$(UpdatePublicKeyPath)')" />
    <Resource Include="Assets/WinMon.ico" />
  </ItemGroup>
  <ItemGroup Condition="'$(NetworkServiceBundleDirectory)' != '' And '$(StoreBuild)' != 'true'">
    <EmbeddedResource Include="$(NetworkServiceBundleDirectory)\WinMon.NetworkSetup.exe" LogicalName="WinMon.NetworkSetup.exe" />
    <EmbeddedResource Include="$(NetworkServiceBundleDirectory)\network-service.zip" LogicalName="WinMon.NetworkSetup.Service.zip" />
    <EmbeddedResource Include="$(NetworkServiceBundleDirectory)\network-service-manifest.json" LogicalName="WinMon.NetworkSetup.Manifest.json" />
    <EmbeddedResource Include="$(NetworkServiceBundleDirectory)\network-service-manifest.sig" LogicalName="WinMon.NetworkSetup.Manifest.sig" />
  </ItemGroup>
  <Target Name="ValidateNetworkServiceBundle" BeforeTargets="PrepareResources" Condition="'$(NetworkServiceBundleDirectory)' != ''">
    <Error Condition="'$(StoreBuild)' == 'true'" Text="Microsoft Store builds cannot include the network service setup bundle." />
    <Error Condition="!Exists('$(NetworkServiceBundleDirectory)\WinMon.NetworkSetup.exe') Or !Exists('$(NetworkServiceBundleDirectory)\network-service.zip') Or !Exists('$(NetworkServiceBundleDirectory)\network-service-manifest.json') Or !Exists('$(NetworkServiceBundleDirectory)\network-service-manifest.sig')" Text="Network service bundle is incomplete." />
  </Target>
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
    <AssemblyMetadata Include="License" Value="$(PackageLicenseExpression)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MonCore/MonCore.csproj" />
    <ProjectReference Include="../MonCore.Windows/MonCore.Windows.csproj" />
  </ItemGroup>
</Project>
