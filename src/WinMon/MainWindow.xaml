<Window
    x:Class="WinMon.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WinMon.Controls"
    xmlns:resources="clr-namespace:WinMon.Resources"
    Title="{Binding [WinMon], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
    Width="836"
    Height="840"
    MinWidth="836"
    MinHeight="160"
    Background="Transparent"
    Closing="OnClosing"
    Icon="Assets/WinMon.ico"
    Loaded="OnLoaded"
    PreviewKeyDown="OnWindowKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="36"
            GlassFrameThickness="0,36,0,0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <Border Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--
                Leave the right caption-button region unpainted so DWM owns its visuals and input.
                AlignTitleBar replaces these fallbacks with the measured caption-button bounds.
            -->
            <Border
                x:Name="TitleBarArea"
                Grid.Row="0"
                Margin="0,0,138,0"
                Padding="12,0,0,0"
                Background="{DynamicResource TitleBarSurface}">
                <DockPanel LastChildFill="True">
                    <Button
                        x:Name="PinButton"
                        controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.AlwaysOnTop}"
                        AutomationProperties.Name="{Binding [KeepOnTopOff], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                        Click="OnPin"
                        Content="{Binding [AlwaysOnTop], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource AlwaysOnTopButton}"
                        ToolTip="{Binding [KeepThisWindowOnTopOfOtherWindows], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button
                        x:Name="CompactViewButton"
                        controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.Compact}"
                        Click="OnToggleCompactView"
                        DockPanel.Dock="Right"
                        Style="{StaticResource TitleActionButton}"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Image
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock
                        x:Name="ViewTitle"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        FontSize="14"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"><Run Text="{Binding [WinMon], Source={x:Static resources:Strings.Text}, Mode=OneWay}" /><Run
                            x:Name="VersionRun"
                            FontSize="12"
                            FontWeight="Normal"
                            Foreground="{DynamicResource Muted}" /></TextBlock>
                    <Button
                        x:Name="InfoButton"
                        controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.Info}"
                        AutomationProperties.Name="{Binding [AboutWinMonAndHardwareInformation], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                        Click="OnHardwareInfo"
                        Content="{Binding [Info], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                        DockPanel.Dock="Left"
                        Style="{StaticResource TitleActionButton}"
                        ToolTip="{Binding [VersionPlusCPUMemoryGraphicsVolumesAndNetworkHardware], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                    <TextBlock
                        x:Name="CompactStatus"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        FontSize="11"
                        Foreground="{DynamicResource SnapshotAccent}"
                        Text="{Binding [LiveMode], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="SettingsButton"
                        controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.Settings}"
                        AutomationProperties.Name="{Binding [WinMonSettings], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                        Click="OnSettings"
                        Content="{Binding [Settings], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                        DockPanel.Dock="Left"
                        Style="{StaticResource TitleActionButton}"
                        ToolTip="{Binding [WinMonSettings], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Border Background="Transparent" />
                </DockPanel>
            </Border>
            <Grid
                x:Name="CompactStrip"
                Grid.Row="1"
                Background="{DynamicResource Surface}"
                Visibility="Collapsed" />
            <Border
                x:Name="FullView"
                Grid.Row="1"
                Background="{DynamicResource Surface}">
                <Grid Margin="20,12,20,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition
                            x:Name="ChartAreaRow"
                            Height="*"
                            MinHeight="160" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition
                            x:Name="ProcessesAreaRow"
                            Height="1.25*"
                            MinHeight="344" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition x:Name="SecondaryDiskColumn" Width="0" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,0,1,0" />
                        <Border
                            Grid.Column="1"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,0,1,0" />
                        <Border
                            Grid.Column="2"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,0,1,0" />
                        <Border
                            Grid.Column="4"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,0,1,0" />
                        <controls:MetricReadout
                            x:Name="CpuMetric"
                            Grid.Column="0"
                            AccentKey="CpuAccent"
                            Label="{Binding [CPU], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                        <controls:MetricReadout
                            x:Name="MemoryMetric"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            AccentKey="MemoryAccent"
                            Label="{Binding [Memory], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                        <controls:MetricReadout
                            x:Name="DiskMetric"
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            AccentKey="DiskAccent"
                            Label="{Binding [Disk], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                        <Border
                            x:Name="SecondaryDiskDivider"
                            Grid.Column="3"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,0,1,0"
                            Visibility="Collapsed" />
                        <controls:MetricReadout
                            x:Name="SecondaryDiskMetric"
                            Grid.Column="3"
                            Margin="10,0,0,0"
                            AccentKey="SecondaryDiskAccent"
                            Label="{Binding [Disk], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                            Visibility="Collapsed" />
                        <controls:MetricReadout
                            x:Name="NetworkMetric"
                            Grid.Column="4"
                            Margin="10,0,0,0"
                            AccentKey="NetworkAccent"
                            Label="{Binding [Network], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                        <controls:MetricReadout
                            x:Name="GpuMetric"
                            Grid.Column="5"
                            Margin="10,0,0,0"
                            AccentKey="GpuAccent"
                            Label="{Binding [GPU], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                    </Grid>
                    <!--  Compact live headers; historical resource details appear only during inspection.  -->
                    <Border
                        x:Name="ResourceHeader"
                        Grid.Row="1"
                        Margin="-20,0,-20,8"
                        Padding="20,5"
                        Background="{DynamicResource SectionHeaderSurface}"
                        BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                x:Name="RangeSelector"
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding [ChartTimeRange], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                Orientation="Horizontal" />
                            <Border
                                x:Name="ChartModeSwitch"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="8,0"
                                Padding="1"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="1"
                                CornerRadius="5">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        x:Name="LiveModeButton"
                                        MinWidth="72"
                                        AutomationProperties.Name="{Binding [ReturnToLive], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                        Click="OnLiveModeClick"
                                        GroupName="ChartMode"
                                        Style="{StaticResource ChartModeSegment}"
                                        ToolTip="{Binding [ReturnToLive], Source={x:Static resources:Strings.Text}, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Data="{x:Static controls:ButtonIcon.Live}"
                                                Stretch="Uniform"
                                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.5" />
                                            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="{Binding [LiveMode], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton
                                        x:Name="SnapshotModeButton"
                                        MinWidth="108"
                                        AutomationProperties.Name="{Binding [SnapshotMode], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                        Click="OnSnapshotModeClick"
                                        GroupName="ChartMode"
                                        Style="{StaticResource ChartModeSegment}"
                                        ToolTip="{Binding [CaptureLatestSnapshot], Source={x:Static resources:Strings.Text}, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                                <Path
                                                    Data="{x:Static controls:ButtonIcon.CaptureFrame}"
                                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                    StrokeEndLineCap="Round"
                                                    StrokeLineJoin="Round"
                                                    StrokeStartLineCap="Round"
                                                    StrokeThickness="1.5" />
                                                <Ellipse
                                                    Width="3"
                                                    Height="3"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                            </Grid>
                                            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="{Binding [SnapshotMode], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                            <!--  Shown only when sampling fails; normal recording needs no status.  -->
                            <TextBlock
                                x:Name="ErrorLabel"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                MaxWidth="190"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource Muted}"
                                TextAlignment="Right"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="LiveCaption"
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="{Binding [SystemResources], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <controls:CpuGraph
                        x:Name="OverallGraph"
                        Grid.Row="2"
                        AutomationProperties.Name="{Binding [CPUMemoryConfiguredDisksNetworkAndGPUOverlayHistoryClick], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                        Focusable="True"
                        ShowGrid="True"
                        SizeChanged="OnSnapshotChartSizeChanged" />
                    <Canvas
                        x:Name="SnapshotLayer"
                        Grid.Row="2"
                        ClipToBounds="True"
                        Visibility="Collapsed">
                        <Polygon
                            x:Name="SnapshotPointer"
                            Fill="{DynamicResource Raised}"
                            IsHitTestVisible="False"
                            Stroke="{DynamicResource Line}"
                            StrokeThickness="1" />
                        <Border
                            x:Name="SnapshotPanel"
                            Padding="12,9"
                            AutomationProperties.Name="{Binding [SelectedChartSnapshot], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                            Background="{DynamicResource Raised}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock
                                        x:Name="SnapshotTitle"
                                        FontSize="15"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="SnapshotNote"
                                        Margin="0,3,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource Muted}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <UniformGrid x:Name="SnapshotReadings" Columns="3">
                                        <UniformGrid.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="11" />
                                                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            </Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Margin" Value="0,0,6,6" />
                                            </Style>
                                        </UniformGrid.Resources>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [CPU], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                            <TextBlock
                                                x:Name="SnapshotCpu"
                                                FontSize="22"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource CpuAccent}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Memory], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                            <TextBlock
                                                x:Name="SnapshotMemory"
                                                FontSize="22"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource MemoryAccent}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [GPU], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                            <TextBlock
                                                x:Name="SnapshotGpu"
                                                FontSize="22"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource GpuAccent}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock x:Name="SnapshotDiskName" />
                                            <TextBlock
                                                x:Name="SnapshotDisk"
                                                FontSize="22"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource DiskAccent}" />
                                        </StackPanel>
                                        <StackPanel x:Name="SnapshotSecondaryDisk">
                                            <TextBlock x:Name="SnapshotSecondaryDiskName" />
                                            <TextBlock
                                                x:Name="SnapshotDisk2"
                                                FontSize="22"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource SecondaryDiskAccent}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Network], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                            <TextBlock
                                                x:Name="SnapshotNetwork"
                                                FontSize="17"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource NetworkAccent}" />
                                        </StackPanel>
                                    </UniformGrid>
                                </ScrollViewer>
                                <Border
                                    Grid.Row="2"
                                    Padding="0,6,0,0"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="SnapshotCopyButton"
                                            controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.Copy}"
                                            Click="OnCopySnapshot"
                                            Content="{Binding [CopySnapshot], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                            Style="{StaticResource ActionBarButton}" />
                                        <Button
                                            x:Name="LiveButton"
                                            Grid.Column="1"
                                            controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.Live}"
                                            Click="OnReturnLive"
                                            Content="{Binding [ReturnToLive], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                            Style="{StaticResource ActionBarLastButton}"
                                            ToolTip="{Binding [ResumeLiveReadingsAndProcessesEndOrEscape], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Canvas>
                    <GridSplitter
                        x:Name="ChartProcessDivider"
                        Grid.Row="3"
                        Height="8"
                        Margin="-20,2,-20,2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding [ResizeChartAndProcesses], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                        Cursor="SizeNS"
                        Focusable="True"
                        KeyboardIncrement="10"
                        ResizeBehavior="PreviousAndNext"
                        ResizeDirection="Rows"
                        ShowsPreview="False"
                        ToolTip="{Binding [ResizeChartAndProcesses], Source={x:Static resources:Strings.Text}, Mode=OneWay}">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Grid Background="Transparent">
                                    <Border
                                        x:Name="DividerLine"
                                        Height="1"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Line}" />
                                    <Border
                                        x:Name="DividerGrip"
                                        Width="32"
                                        Height="3"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Muted}"
                                        CornerRadius="1.5" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DividerGrip" Property="Background" Value="{DynamicResource Accent}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="DividerLine" Property="Background" Value="{DynamicResource Accent}" />
                                        <Setter TargetName="DividerGrip" Property="Background" Value="{DynamicResource Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            Margin="-20,0,-20,0"
                            Padding="20,0,0,0"
                            Background="{DynamicResource SectionHeaderSurface}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel KeyboardNavigation.TabNavigation="Once" Orientation="Horizontal">
                                    <RadioButton
                                        x:Name="ProcessesTab"
                                        Content="{Binding [ProcessesTab], Source={x:Static resources:Strings.Text}}"
                                        GroupName="ActivityView"
                                        IsChecked="True"
                                        Style="{StaticResource ActivityTab}" />
                                    <RadioButton
                                        x:Name="ServicesTab"
                                        Content="{Binding [Services], Source={x:Static resources:Strings.Text}}"
                                        GroupName="ActivityView"
                                        Style="{StaticResource ActivityTab}" />
                                </StackPanel>
                                <Button
                                    x:Name="ActivityActionsToggle"
                                    Grid.Column="1"
                                    Margin="0,0,20,0"
                                    Click="OnToggleActivityActions"
                                    FontSize="12"
                                    Foreground="{DynamicResource Muted}"
                                    Style="{StaticResource TitleActionButton}" />
                            </Grid>
                        </Border>
                        <Grid x:Name="ProcessesArea" Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="108" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="ProcessHeader"
                                Grid.Row="0"
                                Margin="-20,0,-20,8"
                                Padding="20,5"
                                Background="{DynamicResource SectionHeaderSurface}"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="0">
                                <StackPanel>
                                    <Grid x:Name="ProcessToolbarGrid">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel
                                            x:Name="ProcessGroupingControls"
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding [ProcessGrouping], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                            Orientation="Horizontal">
                                            <RadioButton
                                                x:Name="IndividualChip"
                                                AutomationProperties.Name="{Binding [OneRowPerProcess], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                                Content="{Binding [Individual], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                                GroupName="ProcessGrouping"
                                                IsChecked="True"
                                                Style="{StaticResource RangeChip}"
                                                ToolTip="{Binding [OneRowPerProcess], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                            <RadioButton
                                                x:Name="GroupedChip"
                                                Margin="0"
                                                AutomationProperties.Name="{Binding [OneRowPerExecutable], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                                Content="{Binding [Grouped], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                                GroupName="ProcessGrouping"
                                                Style="{StaticResource RangeChip}"
                                                ToolTip="{Binding [OneRowPerExecutableCPUAndIOSummedGPU], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel
                                            x:Name="ProcessRankingControls"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="{Binding [Top], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                            <ComboBox
                                                x:Name="ProcessCountSelector"
                                                MinWidth="60"
                                                MinHeight="28"
                                                Margin="6,0"
                                                Padding="6,3,24,3"
                                                AutomationProperties.Name="{Binding [NumberOfTopProcesses], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                ToolTip="{Binding [NumberOfProcessesShown], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="{Binding [ProcessesBy], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                            <ComboBox
                                                x:Name="ProcessSortSelector"
                                                MinWidth="90"
                                                MinHeight="28"
                                                Margin="6,0,0,0"
                                                Padding="8,3,26,3"
                                                AutomationProperties.Name="{Binding [RankProcessesBy], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                ToolTip="{Binding [RankByFiveSecondAverageCPUGPUOrIO], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                        </StackPanel>
                                        <Border
                                            x:Name="ProcessSearchBorder"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="3"
                                            MinWidth="120"
                                            Margin="0,6,12,0"
                                            Background="{DynamicResource SearchSurface}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="14"
                                                    Foreground="{DynamicResource Muted}"
                                                    IsHitTestVisible="False"
                                                    Text="{Binding [SearchGlyph], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                                <TextBox
                                                    x:Name="ProcessSearchBox"
                                                    Grid.Column="1"
                                                    MinHeight="26"
                                                    Padding="0,3"
                                                    VerticalContentAlignment="Center"
                                                    AutomationProperties.Name="{Binding [SearchProcessesByNameOrPID], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    CaretBrush="{DynamicResource Text}"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource Text}"
                                                    HorizontalScrollBarVisibility="Hidden"
                                                    ToolTip="{Binding [FilterRankedProcessesByNameOrPIDCtrlFEscape], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                                <TextBlock
                                                    x:Name="ProcessSearchPlaceholder"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource Muted}"
                                                    IsHitTestVisible="False"
                                                    Text="{Binding [SearchNameOrPID], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Button
                                                    x:Name="ClearProcessSearchButton"
                                                    Grid.Column="2"
                                                    Width="28"
                                                    MinHeight="26"
                                                    Margin="0"
                                                    Padding="0"
                                                    controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.Cancel}"
                                                    AutomationProperties.Name="{Binding [ClearProcessSearch], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnClearProcessSearch"
                                                    ToolTip="{Binding [ClearSearch], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                                    Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <CheckBox
                                            x:Name="AppsOnlyCheckBox"
                                            Grid.Row="1"
                                            Grid.Column="3"
                                            Margin="0,6,0,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding [AppOnly], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                            Content="{Binding [AppOnly], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                            FontSize="12"
                                            Foreground="{DynamicResource Text}"
                                            ToolTip="{Binding [ProcessKindExplanation], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                        <CheckBox
                                            x:Name="PinnedOnlyCheckBox"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalAlignment="Right"
                                            AutomationProperties.Name="{Binding [PinnedOnly], Source={x:Static resources:Strings.Text}}"
                                            Content="{Binding [PinnedOnly], Source={x:Static resources:Strings.Text}}"
                                            FontSize="12"
                                            Foreground="{DynamicResource Text}"
                                            ToolTip="{Binding [PinnedProcessesExplanation], Source={x:Static resources:Strings.Text}}" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="SelectionLabel"
                                        Margin="0,4,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource Muted}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <Grid
                                Grid.Row="1"
                                Width="{Binding ViewportWidth, ElementName=ProcessScroll}"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="55" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <Grid HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource Muted}"
                                        Text="{Binding [ProcessColumn], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                    <TextBlock
                                        x:Name="CoverageLabel"
                                        Grid.Column="1"
                                        Margin="10,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource Muted}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding [UnattributedCPUIsTotalCPUMinusAllMeasuredProcessesKernel2], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                    <StackPanel
                                        x:Name="PinSummary"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Margin="2,0,6,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource Muted}"
                                            Text="·" />
                                        <TextBlock
                                            x:Name="PinnedCountLabel"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource ProcessPinAccent}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    x:Name="ProcessHistoryHeader"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource Muted}"
                                    Text="{Binding [History], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                    ToolTip="{Binding [CPUHistoryOnOneScaleSharedByEveryRowHover], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="CpuHeader"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    Foreground="{DynamicResource Muted}"
                                    Text="{Binding [CpuColumn], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                    ToolTip="{Binding [AverageOverTheLast5SecondsWindowsCountsProcessCPU], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="GpuHeader"
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    Foreground="{DynamicResource Muted}"
                                    Text="{Binding [GpuColumn], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                    ToolTip="{Binding [BusiestGPUEnginePerProcessAveragedOverReadableIntervalsIn], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="MemoryHeader"
                                    Grid.Column="4"
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    Foreground="{DynamicResource Muted}"
                                    Text="{Binding [Memory], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                    ToolTip="{Binding [ResidentWorkingSetIncludingSharedPages], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="IoHeader"
                                    Grid.Column="5"
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    Foreground="{DynamicResource Muted}"
                                    Text="{Binding [IOMBS], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                    ToolTip="{Binding [ProcessReadWriteIOIncludesFileNetworkAndDevice], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="ThreadsHeader"
                                    Grid.Column="6"
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    Foreground="{DynamicResource Muted}"
                                    Text="{Binding [Threads], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                    ToolTip="{Binding [ProcessThreadsExplanation], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="HandlesHeader"
                                    Grid.Column="7"
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    Foreground="{DynamicResource Muted}"
                                    Text="{Binding [Handles], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                    ToolTip="{Binding [ProcessHandlesExplanation], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                            </Grid>
                            <ScrollViewer
                                x:Name="ProcessScroll"
                                Grid.Row="2"
                                Padding="0,0,0,0"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ProcessRows">
                                    <StackPanel x:Name="PinnedProcessRows" />
                                    <Border
                                        x:Name="RankedDivider"
                                        Padding="0,5"
                                        BorderBrush="{DynamicResource Line}"
                                        BorderThickness="0,1,0,0"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            x:Name="RankedDividerText"
                                            FontSize="11"
                                            Foreground="{DynamicResource Muted}" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <controls:ProcessActionBar x:Name="ProcessActions" Grid.Row="3" />
                            <TextBlock
                                x:Name="EmptyLabel"
                                Grid.Row="2"
                                Margin="0,8"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Muted}"
                                Text="{Binding [CollectingTheFirstInterval], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                        <controls:ServicesView
                            x:Name="ServiceView"
                            Grid.Row="1"
                            Visibility="Collapsed" />
                    </Grid>
                    <Border
                        x:Name="UpdateFooter"
                        Grid.Row="5"
                        Margin="0,10,0,0"
                        Padding="12,8"
                        Background="{DynamicResource SectionHeaderSurface}"
                        BorderBrush="{DynamicResource Line}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="UpdateStatusText"
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <Button
                                x:Name="ReleaseNotesButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnReleaseNotes"
                                Content="{Binding [WhatsNew], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                Foreground="{DynamicResource Text}"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="UpdateNowButton"
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Click="OnUpdateNow"
                                Content="{Binding [UpdateNow], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                ToolTip="{Binding [UpdateNowHelp], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="CancelUpdateButton"
                                Grid.Column="3"
                                Margin="8,0,0,0"
                                Click="OnCancelUpdate"
                                Content="{Binding [Cancel], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="DismissUpdateButton"
                                Grid.Column="4"
                                Width="28"
                                Margin="8,0,0,0"
                                Padding="0"
                                controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.Cancel}"
                                AutomationProperties.Name="{Binding [Dismiss], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnDismissUpdate" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
