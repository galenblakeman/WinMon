<Window
    x:Class="WinMon.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WinMon.Controls"
    Title="WinMon · System Activity"
    Width="600"
    Height="840"
    MinWidth="600"
    MinHeight="800"
    Background="Transparent"
    Closing="OnClosing"
    Icon="Assets/WinMon.ico"
    Loaded="OnLoaded"
    PreviewKeyDown="OnWindowKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="48"
            GlassFrameThickness="0,48,0,0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <Border Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  Leave the right caption-button region unpainted so DWM owns its visuals and input.  -->
            <Border
                Grid.Row="0"
                Margin="0,0,150,0"
                Padding="16,0,0,0"
                Background="{DynamicResource TitleBarSurface}">
                <DockPanel LastChildFill="True">
                    <StackPanel
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal">
                        <Button
                            x:Name="PinButton"
                            controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.Pin}"
                            AutomationProperties.Name="Toggle always on top"
                            Click="OnPin"
                            Content="Pin"
                            ToolTip="Keep this window above other windows"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button
                            x:Name="ExpandButton"
                            controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.Expand}"
                            AutomationProperties.Name="Expand investigation view"
                            Click="OnExpand"
                            Content="Expand"
                            ToolTip="Switch between the compact view and the wider history view"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                    <Image
                        Width="18"
                        Height="18"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock
                        x:Name="ViewTitle"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="WinMon · System Activity"
                        TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Background="{DynamicResource Surface}">
                <Grid Margin="20,12,20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="160" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.25*" MinHeight="108" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,0,1,0" />
                        <Border
                            Grid.Column="1"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,0,1,0" />
                        <Border
                            Grid.Column="2"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,0,1,0" />
                        <Border
                            Grid.Column="3"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,0,1,0" />
                        <controls:MetricReadout
                            x:Name="CpuMetric"
                            Grid.Column="0"
                            AccentKey="CpuAccent"
                            Caption="Total processor usage"
                            Label="CPU" />
                        <controls:MetricReadout
                            x:Name="MemoryMetric"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            AccentKey="MemoryAccent"
                            Caption="RAM in use"
                            Label="Memory" />
                        <controls:MetricReadout
                            x:Name="DiskMetric"
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            AccentKey="DiskAccent"
                            Caption="Active time"
                            Label="Disk" />
                        <controls:MetricReadout
                            x:Name="NetworkMetric"
                            Grid.Column="3"
                            Margin="10,0,0,0"
                            AccentKey="NetworkAccent"
                            Caption="Busier link direction"
                            Label="Network" />
                        <controls:MetricReadout
                            x:Name="GpuMetric"
                            Grid.Column="4"
                            Margin="10,0,0,0"
                            AccentKey="GpuAccent"
                            Caption="Busiest GPU engine"
                            Label="GPU" />
                    </Grid>
                    <!--  Section headers share a graphite surface, full-width divider, and title/subtitle typography.  -->
                    <Border
                        Grid.Row="1"
                        Margin="-20,0,-20,8"
                        Padding="20,10,20,10"
                        Background="{DynamicResource SectionHeaderSurface}"
                        BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="False">
                            <Button
                                x:Name="PauseButton"
                                controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.Pause}"
                                AutomationProperties.Name="Pause or resume recording"
                                Click="OnPause"
                                Content="Pause"
                                DockPanel.Dock="Right" />
                            <Button
                                x:Name="LiveButton"
                                controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.Live}"
                                Click="OnReturnLive"
                                Content="Return to live"
                                DockPanel.Dock="Right"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="StatusLabel"
                                MaxWidth="190"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                FontSize="11"
                                Foreground="{DynamicResource Muted}"
                                Text="Collecting…"
                                TextAlignment="Right"
                                TextWrapping="Wrap" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="LiveCaption"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="System resources" />
                                <TextBlock
                                    x:Name="RangeLabel"
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource Muted}"
                                    Text="Last 2 min · 0–100%" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <controls:CpuGraph
                        x:Name="OverallGraph"
                        Grid.Row="2"
                        AutomationProperties.Name="CPU, memory, disk and network overlay history. Click to inspect; arrow keys move, End returns to live."
                        Focusable="True"
                        ShowGrid="True" />
                    <Border
                        Grid.Row="3"
                        Margin="-20,10,-20,8"
                        Padding="20,10,20,10"
                        Background="{DynamicResource SectionHeaderSurface}"
                        BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,1,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="Top" />
                                <ComboBox
                                    x:Name="ProcessCountSelector"
                                    Width="58"
                                    MinHeight="28"
                                    Margin="6,0"
                                    AutomationProperties.Name="Number of top processes"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    ToolTip="Number of processes shown" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="processes by" />
                                <ComboBox
                                    x:Name="ProcessSortSelector"
                                    Width="100"
                                    MinHeight="28"
                                    Margin="6,0,0,0"
                                    AutomationProperties.Name="Rank processes by"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    ToolTip="Rank by five-second average CPU, GPU or I/O, or by current memory" />
                            </StackPanel>
                            <TextBlock
                                x:Name="SelectionLabel"
                                Margin="0,2,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Muted}"
                                Text="Individual processes · 5s average of total CPU"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="SelectionMetrics"
                                Margin="0,5,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource Text}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Grid
                        Grid.Row="4"
                        Width="{Binding ViewportWidth, ElementName=ProcessScroll}"
                        Margin="0,0,0,5"
                        HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="55" />
                            <ColumnDefinition Width="55" />
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="75" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource Muted}"
                            Text="Process" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource Muted}"
                            Text="History"
                            ToolTip="CPU history on one scale shared by every row. Hover a row for the scale." />
                        <TextBlock
                            x:Name="CpuHeader"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{DynamicResource Muted}"
                            Text="CPU %"
                            ToolTip="Average over the last 5 seconds. Windows counts process CPU in 15.6 ms ticks, so single seconds often read zero." />
                        <TextBlock
                            x:Name="GpuHeader"
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{DynamicResource Muted}"
                            Text="GPU %"
                            ToolTip="Busiest GPU engine per process, averaged over readable intervals in the last 5 seconds. Percentages are not additive." />
                        <TextBlock
                            x:Name="MemoryHeader"
                            Grid.Column="4"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{DynamicResource Muted}"
                            Text="Memory"
                            ToolTip="Resident working set, including shared pages" />
                        <TextBlock
                            x:Name="IoHeader"
                            Grid.Column="5"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{DynamicResource Muted}"
                            Text="I/O MB/s"
                            ToolTip="Process read/write I/O includes file, network and device operations; not disk-only throughput" />
                    </Grid>
                    <ScrollViewer
                        x:Name="ProcessScroll"
                        Grid.Row="5"
                        Padding="0,0,0,0"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ProcessRows" />
                    </ScrollViewer>
                    <TextBlock
                        x:Name="EmptyLabel"
                        Grid.Row="5"
                        Margin="0,8"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Muted}"
                        Text="Collecting the first interval…"
                        TextWrapping="Wrap" />
                    <DockPanel
                        Grid.Row="6"
                        Margin="0,12,0,0"
                        LastChildFill="True">
                        <StackPanel
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal">
                            <Button
                                controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.Tray}"
                                Click="OnTray"
                                Content="Hide to tray"
                                ToolTip="Hide to the notification area; double-click the tray icon to restore" />
                            <Button
                                x:Name="SettingsButton"
                                controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.Settings}"
                                Click="OnSettings"
                                Content="Settings" />
                        </StackPanel>
                        <TextBlock
                            x:Name="CoverageLabel"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource Muted}"
                            TextWrapping="Wrap"
                            ToolTip="Unattributed CPU is total CPU minus all measured processes: kernel and interrupt time, measurement timing, and processes WinMon cannot open without administrator access." />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
