<UserControl x:Class="WinMon.Preferences.ServicesSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:resources="clr-namespace:WinMon.Resources">
    <StackPanel>
        <TextBlock Margin="0,0,0,12" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource Muted}" Text="{x:Static resources:Strings.ServicesIntro}" />
        <Border x:Name="HardwareSection" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,12,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource Accent}"
                               automation:AutomationProperties.HeadingLevel="Level2"
                               Text="{x:Static resources:Strings.ServicesHardwareHeading}" />
                    <ContentPresenter x:Name="HardwareStatusPresenter" Grid.Column="1" MaxWidth="180" VerticalAlignment="Top" />
                </Grid>
                <ContentPresenter x:Name="HardwareEnabledPresenter" />
                <TextBlock Margin="0,4,0,6" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource Muted}" Text="{x:Static resources:Strings.ServicesHardwareNote}" />
                <WrapPanel>
                    <ContentPresenter x:Name="HardwareRepairPresenter" />
                    <ContentPresenter x:Name="HardwareRemovePresenter" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,12,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource Accent}"
                               automation:AutomationProperties.HeadingLevel="Level2"
                               Text="{x:Static resources:Strings.NetworkProcessMonitoringHeading}" />
                    <ContentPresenter x:Name="NetworkStatusPresenter" Grid.Column="1" MaxWidth="180" VerticalAlignment="Top" />
                </Grid>
                <ContentPresenter x:Name="NetworkEnabledPresenter" />
                <TextBlock Margin="0,4,0,6" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource Muted}" Text="{x:Static resources:Strings.ServicesNetworkNote}" />
                <WrapPanel>
                    <ContentPresenter x:Name="NetworkRepairPresenter" />
                    <ContentPresenter x:Name="NetworkRemovePresenter" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
