<UserControl x:Class="WinMon.Preferences.AutoCaptureSection" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:WinMon.Resources">
    <UserControl.Resources>
        <Style x:Key="CaptureTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Underline" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource Raised}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource Raised}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{x:Static r:Strings.CaptureSettingsIntro}" Foreground="{DynamicResource Muted}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TabControl x:Name="CaptureTabs" ItemContainerStyle="{StaticResource CaptureTab}" SelectedIndex="0"
                    AutomationProperties.Name="{x:Static r:Strings.AutoCaptureHeading}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                            <WrapPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </StackPanel>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem x:Name="BuiltInTab" Header="{x:Static r:Strings.CaptureBuiltInTab}">
                <ContentControl x:Name="BuiltInHost" Focusable="False" />
            </TabItem>
            <TabItem x:Name="TargetsTab" Header="{x:Static r:Strings.CaptureTargetsTab}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="AddRuleButton" DockPanel.Dock="Right" MinWidth="74" Margin="10,0,0,0"
                                Content="{x:Static r:Strings.CaptureAddRule}" Click="AddRule_Click" />
                        <TextBlock Text="{x:Static r:Strings.CaptureTargetsIntro}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                    </DockPanel>
                    <TextBlock x:Name="NoTargetRules" Text="{x:Static r:Strings.CaptureNoTargetRules}"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,6" />
                    <ItemsControl x:Name="TargetRulesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" VerticalAlignment="Center"
                                                  Foreground="{DynamicResource Text}"
                                                  AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Summary}"
                                                  Checked="TargetEnabled_Changed" Unchecked="TargetEnabled_Changed"
                                                  Margin="2,0,8,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}"
                                                       FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{x:Static r:Strings.CaptureEditRule}"
                                                AutomationProperties.HelpText="{Binding Name}" Click="EditRule_Click"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="RuleEditor" Visibility="Collapsed" Margin="0,10,0,0" Padding="12"
                            CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                            Background="{DynamicResource SectionHeaderSurface}">
                        <StackPanel>
                            <TextBlock x:Name="EditorHeading" FontSize="15" FontWeight="SemiBold"
                                       AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock x:Name="TargetTypeLabel" Style="{StaticResource EditorLabel}"
                                               Text="{x:Static r:Strings.CaptureTargetType}" />
                                    <ComboBox x:Name="TargetType" MinHeight="26"
                                              AutomationProperties.LabeledBy="{Binding ElementName=TargetTypeLabel}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="TargetNameLabel" Style="{StaticResource EditorLabel}" />
                                    <TextBox x:Name="TargetName" MaxLength="512" MinHeight="26"
                                             VerticalContentAlignment="Center" Background="{DynamicResource Raised}"
                                             Foreground="{DynamicResource Text}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=TargetNameLabel}" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel>
                                <StackPanel Width="124" Margin="0,0,10,8">
                                    <TextBlock x:Name="MetricLabel" Style="{StaticResource EditorLabel}"
                                               Text="{x:Static r:Strings.CaptureMetricLabel}" />
                                    <ComboBox x:Name="TargetMetric" MinHeight="26"
                                              AutomationProperties.LabeledBy="{Binding ElementName=MetricLabel}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,8">
                                    <TextBlock x:Name="ThresholdLabel" Style="{StaticResource EditorLabel}"
                                               Text="{x:Static r:Strings.AutoCaptureAboveHeader}" />
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl x:Name="ThresholdHost" Focusable="False" />
                                        <TextBlock x:Name="ThresholdUnit" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Muted}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="DurationLabel" Style="{StaticResource EditorLabel}"
                                               Text="{x:Static r:Strings.AutoCaptureForHeader}" />
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl x:Name="DurationHost" Focusable="False" />
                                        <TextBlock Text="{x:Static r:Strings.AutoCaptureSecondsUnit}" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock x:Name="FeatureNote" Foreground="{DynamicResource Muted}"
                                       TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                            <TextBlock x:Name="EditorError" Foreground="{DynamicResource Text}" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,8" Visibility="Collapsed" />
                            <WrapPanel HorizontalAlignment="Right">
                                <Button x:Name="RemoveRuleButton" Click="RemoveRule_Click" Margin="0,0,6,0"
                                        Content="{x:Static r:Strings.CaptureRemoveScopedRule}" />
                                <Button x:Name="DiscardRuleButton" Content="{x:Static r:Strings.CaptureDiscardRule}" Click="DiscardRule_Click"
                                        Margin="0,0,6,0" />
                                <Button x:Name="ApplyRuleButton" Click="ApplyRule_Click"
                                        BorderBrush="{DynamicResource Accent}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="ReportTab" Header="{x:Static r:Strings.CaptureReportOptionsTab}">
                <StackPanel x:Name="ReportOptions">
                    <TextBlock Text="{x:Static r:Strings.AutoCaptureHelp}" Foreground="{DynamicResource Muted}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
