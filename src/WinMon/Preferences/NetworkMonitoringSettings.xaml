<UserControl x:Class="WinMon.Preferences.NetworkMonitoringSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:resources="clr-namespace:WinMon.Resources">
    <StackPanel>
        <TextBlock Margin="0,16,0,4" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource Accent}"
                   automation:AutomationProperties.HeadingLevel="Level2"
                   Text="{x:Static resources:Strings.NetworkProcessMonitoringHeading}" />
        <ContentPresenter x:Name="EnabledPresenter" />
        <TextBlock Margin="0,4,0,8" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource Muted}"
                   Text="{x:Static resources:Strings.NetworkProcessMonitoringNote}" />
        <ContentPresenter x:Name="StatusPresenter" />
        <ContentPresenter x:Name="RepairPresenter" />
        <ContentPresenter x:Name="RemovePresenter" />
    </StackPanel>
</UserControl>
