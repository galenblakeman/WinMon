<UserControl x:Class="WinMon.Preferences.AppearancePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinMon.Controls"
             Focusable="False" IsHitTestVisible="False">
    <Border x:Name="PreviewSurface" BorderThickness="1" CornerRadius="4" Padding="8"
            Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource Line}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="104" />
            </Grid.RowDefinitions>
            <UniformGrid Rows="2" Columns="3" Background="{DynamicResource SectionHeaderSurface}">
                <controls:MetricReadout x:Name="CpuReadout" Margin="7,4" />
                <controls:MetricReadout x:Name="MemoryReadout" Margin="7,4" />
                <controls:MetricReadout x:Name="DiskReadout" Margin="7,4" />
                <controls:MetricReadout x:Name="NetworkReadout" Margin="7,4" />
                <controls:MetricReadout x:Name="GpuReadout" Margin="7,4" />
                <controls:MetricReadout x:Name="SecondaryDiskReadout" Margin="7,4" />
            </UniformGrid>
            <controls:CpuGraph x:Name="Chart" Grid.Row="1" Margin="0,6,0,0" />
        </Grid>
    </Border>
</UserControl>
