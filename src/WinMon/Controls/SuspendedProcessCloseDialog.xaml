<Window x:Class="WinMon.Controls.SuspendedProcessCloseDialog" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShowInTaskbar="False" SizeToContent="Height" Width="480" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="ResumeButton" MinWidth="110" Margin="0,0,8,0" IsDefault="True"/>
      <Button x:Name="LeaveButton" MinWidth="120" Margin="0,0,8,0"/>
      <Button x:Name="CancelButton" MinWidth="90" IsCancel="True"/>
    </WrapPanel>
    <TextBlock x:Name="Prompt" FontSize="14" TextWrapping="Wrap"/>
  </DockPanel>
</Window>
