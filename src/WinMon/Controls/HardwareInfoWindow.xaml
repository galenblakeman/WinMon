<Window x:Class="WinMon.Controls.HardwareInfoWindow" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WinMon.Controls"
    xmlns:r="clr-namespace:WinMon.Resources"
    Title="{Binding [Info], Source={x:Static r:Strings.Text}}"
    Width="620" Height="720" MinWidth="420" MinHeight="350"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" FontSize="14">
    <Window.Resources>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,16" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Padding="18,12" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,3">
                            <ContentPresenter x:Name="HeaderContent" ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Raised}" />
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="HeaderContent" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                <ToggleButton x:Name="Toggle" HorizontalContentAlignment="Stretch"
                                    Foreground="{DynamicResource Text}"
                                    AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Header" Padding="8,12" Background="Transparent"
                                                    BorderBrush="Transparent" BorderThickness="1">
                                                <DockPanel>
                                                    <Path x:Name="Chevron" Width="14" Height="14" Margin="0,0,12,0"
                                                        Data="{x:Static local:ButtonIcon.ChevronDown}" Stretch="Uniform"
                                                        Stroke="{DynamicResource Text}" StrokeThickness="1.5"
                                                        RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform><RotateTransform Angle="-90" /></Path.RenderTransform>
                                                    </Path>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                   Foreground="{DynamicResource Text}" FontWeight="SemiBold" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}" Value="{x:Null}">
                                                                            <Setter Property="Grid.ColumnSpan" Value="2" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                            <Setter Property="Grid.ColumnSpan" Value="2" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                   Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                   ToolTip="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                   TextTrimming="CharacterEllipsis" TextAlignment="Right"
                                                                   FontSize="12" Foreground="{DynamicResource Muted}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Header" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Header" Property="Background" Value="{DynamicResource Raised}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Border>
                            <ContentPresenter x:Name="Details" Margin="34,0,12,12" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Surface}">
        <DockPanel Margin="24,12,24,16">
            <Border DockPanel.Dock="Bottom" Padding="0,12,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                <Button HorizontalAlignment="Right" MinWidth="90" IsCancel="True" Click="OnClose"
                        local:ButtonIcon.Data="{x:Static local:ButtonIcon.Cancel}" Content="{Binding [Close], Source={x:Static r:Strings.Text}}" />
            </Border>
            <TabControl x:Name="Tabs" Background="{DynamicResource Surface}" BorderThickness="0" Padding="0,16,0,12">
                <TabItem Header="{Binding [InfoHardware], Source={x:Static r:Strings.Text}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"
                                   Text="{Binding [InfoHardware], Source={x:Static r:Strings.Text}}" />
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,8">
                            <Button x:Name="RefreshButton" MinWidth="90" Click="OnRefresh" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Live}"
                                    Content="{Binding [Refresh], Source={x:Static r:Strings.Text}}" />
                            <Button x:Name="CopyButton" MinWidth="90" Margin="8,0,0,0" IsEnabled="False" Click="OnCopy"
                                    local:ButtonIcon.Data="{x:Static local:ButtonIcon.Copy}" Content="{Binding [Copy], Source={x:Static r:Strings.Text}}"
                                    AutomationProperties.Name="{Binding [CopyAllInformation], Source={x:Static r:Strings.Text}}"
                                    ToolTip="{Binding [CopyAllInformationAsPlainText], Source={x:Static r:Strings.Text}}" />
                        </WrapPanel>
                        <TextBlock x:Name="SnapshotNote" DockPanel.Dock="Bottom" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <ScrollViewer x:Name="HardwareScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="Sections" />
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem Header="{Binding [InfoGuide], Source={x:Static r:Strings.Text}}">
                    <ScrollViewer x:Name="GuideScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="GuideTopics">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding [InfoGuideTitle], Source={x:Static r:Strings.Text}}" />
                            <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Text="{Binding [InfoGuideIntro], Source={x:Static r:Strings.Text}}" />
                            <Expander IsExpanded="True" Header="{Binding [GuideChartsTitle], Source={x:Static r:Strings.Text}}">
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [GuideChartsBody], Source={x:Static r:Strings.Text}}" />
                            </Expander>
                            <Expander Header="{Binding [GuideProcessesTitle], Source={x:Static r:Strings.Text}}">
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [GuideProcessesBody], Source={x:Static r:Strings.Text}}" />
                            </Expander>
                            <Expander Header="{Binding [GuideServicesTitle], Source={x:Static r:Strings.Text}}">
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [GuideServicesBody], Source={x:Static r:Strings.Text}}" />
                            </Expander>
                            <Expander Header="{Binding [GuideUsageTitle], Source={x:Static r:Strings.Text}}">
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [GuideUsageBody], Source={x:Static r:Strings.Text}}" />
                            </Expander>
                            <Expander Header="{Binding [GuideConnectionsTitle], Source={x:Static r:Strings.Text}}">
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [GuideConnectionsBody], Source={x:Static r:Strings.Text}}" />
                            </Expander>
                            <Expander Header="{Binding [GuideExportTitle], Source={x:Static r:Strings.Text}}">
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [GuideExportBody], Source={x:Static r:Strings.Text}}" />
                            </Expander>
                            <Expander Header="{Binding [GuideAutomaticTitle], Source={x:Static r:Strings.Text}}">
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [GuideAutomaticBody], Source={x:Static r:Strings.Text}}" />
                            </Expander>
                            <Expander Header="{Binding [GuideCompactTitle], Source={x:Static r:Strings.Text}}">
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [GuideCompactBody], Source={x:Static r:Strings.Text}}" />
                            </Expander>
                            <Expander Header="{Binding [GuideWalkthroughTitle], Source={x:Static r:Strings.Text}}">
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [GuideWalkthroughBody], Source={x:Static r:Strings.Text}}" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{Binding [InfoAbout], Source={x:Static r:Strings.Text}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel Margin="8,12,8,28">
                                <TextBlock Text="{Binding [WinMon], Source={x:Static r:Strings.Text}}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,8,0,16" />
                                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock x:Name="LicenseText" TextWrapping="Wrap" TextAlignment="Center" Margin="0,20,0,8" Foreground="{DynamicResource Muted}" />
                                <TextBlock TextAlignment="Center" TextWrapping="Wrap">
                                    <Hyperlink x:Name="RepositoryLink" Foreground="{DynamicResource Accent}" RequestNavigate="OnRepositoryNavigate"
                                               AutomationProperties.Name="{Binding [WinMonSourceCodeOnGitHub], Source={x:Static r:Strings.Text}}" />
                                </TextBlock>
                            </StackPanel>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding [Updates], Source={x:Static r:Strings.Text}}" />
                                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Body}" AutomationProperties.LiveSetting="Polite" />
                                    <WrapPanel>
                                        <Button x:Name="CheckButton" Click="OnCheckForUpdates" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Live}"
                                                Content="{Binding [CheckForUpdates], Source={x:Static r:Strings.Text}}" />
                                        <Button x:Name="UpdateButton" Margin="8,0,0,0" Click="OnUpdate" Visibility="Collapsed"
                                                BorderBrush="{DynamicResource Accent}"
                                                ToolTip="{Binding [UpdateNowHelp], Source={x:Static r:Strings.Text}}"
                                                Content="{Binding [UpdateNow], Source={x:Static r:Strings.Text}}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Button x:Name="OpenLogsButton" HorizontalAlignment="Left" Margin="0,20,0,0"
                                    Click="OnOpenLogs"
                                    ToolTip="{Binding [OpenLogsFolderHelp], Source={x:Static r:Strings.Text}}"
                                    Content="{Binding [OpenLogsFolder], Source={x:Static r:Strings.Text}}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
