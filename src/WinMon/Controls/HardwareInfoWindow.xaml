<Window x:Class="WinMon.Controls.HardwareInfoWindow" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WinMon.Controls"
    xmlns:r="clr-namespace:WinMon.Resources"
    Title="{Binding [Info], Source={x:Static r:Strings.Text}}"
    Width="620" Height="720" MinWidth="420" MinHeight="350"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" FontSize="14">
    <Window.Resources>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,16" />
        </Style>
        <!-- Header is the step number; ButtonIcon.Data is the icon of the button the step names. -->
        <Style x:Key="GuideStep" TargetType="HeaderedContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top"
                                    BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
                                <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Path x:Name="Icon" Grid.Column="1" Width="16" Height="16" Margin="10,3,0,0" VerticalAlignment="Top"
                                  Data="{Binding (local:ButtonIcon.Data), RelativeSource={RelativeSource TemplatedParent}}"
                                  Stretch="Uniform" Stroke="{DynamicResource Text}" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Grid.Column="2" Margin="10,2,0,0" TextWrapping="Wrap"
                                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GuideShowMe" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="58,4,0,4" />
            <Setter Property="local:ButtonIcon.Data" Value="{x:Static local:ButtonIcon.Locate}" />
            <Setter Property="Content" Value="{Binding [GuideShowMe], Source={x:Static r:Strings.Text}}" />
            <Setter Property="ToolTip" Value="{Binding [GuideShowMeHelp], Source={x:Static r:Strings.Text}}" />
            <EventSetter Event="Click" Handler="OnShowMe" />
        </Style>
        <Style x:Key="GuideIntro" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Margin" Value="0,8,0,12" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Padding="18,12" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,3">
                            <ContentPresenter x:Name="HeaderContent" ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Raised}" />
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="HeaderContent" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                <ToggleButton x:Name="Toggle" HorizontalContentAlignment="Stretch"
                                    Foreground="{DynamicResource Text}"
                                    AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Header" Padding="8,12" Background="Transparent"
                                                    BorderBrush="Transparent" BorderThickness="1">
                                                <DockPanel>
                                                    <Path x:Name="Chevron" Width="14" Height="14" Margin="0,0,12,0"
                                                        Data="{x:Static local:ButtonIcon.ChevronDown}" Stretch="Uniform"
                                                        Stroke="{DynamicResource Text}" StrokeThickness="1.5"
                                                        RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform><RotateTransform Angle="-90" /></Path.RenderTransform>
                                                    </Path>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                   Foreground="{DynamicResource Text}" FontWeight="SemiBold" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}" Value="{x:Null}">
                                                                            <Setter Property="Grid.ColumnSpan" Value="2" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                            <Setter Property="Grid.ColumnSpan" Value="2" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                   Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                   ToolTip="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                   TextTrimming="CharacterEllipsis" TextAlignment="Right"
                                                                   FontSize="12" Foreground="{DynamicResource Muted}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Header" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Header" Property="Background" Value="{DynamicResource Raised}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Border>
                            <ContentPresenter x:Name="Details" Margin="34,0,12,12" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Surface}">
        <DockPanel Margin="24,12,24,16">
            <Border DockPanel.Dock="Bottom" Padding="0,12,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                <Button HorizontalAlignment="Right" MinWidth="90" IsCancel="True" Click="OnClose"
                        local:ButtonIcon.Data="{x:Static local:ButtonIcon.Cancel}" Content="{Binding [Close], Source={x:Static r:Strings.Text}}" />
            </Border>
            <TabControl x:Name="Tabs" Background="{DynamicResource Surface}" BorderThickness="0" Padding="0,16,0,12">
                <TabItem Header="{Binding [InfoHardware], Source={x:Static r:Strings.Text}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"
                                   Text="{Binding [InfoHardware], Source={x:Static r:Strings.Text}}" />
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,8">
                            <Button x:Name="RefreshButton" MinWidth="90" Click="OnRefresh" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Live}"
                                    Content="{Binding [Refresh], Source={x:Static r:Strings.Text}}" />
                            <Button x:Name="CopyButton" MinWidth="90" Margin="8,0,0,0" IsEnabled="False" Click="OnCopy"
                                    local:ButtonIcon.Data="{x:Static local:ButtonIcon.Copy}" Content="{Binding [Copy], Source={x:Static r:Strings.Text}}"
                                    AutomationProperties.Name="{Binding [CopyAllInformation], Source={x:Static r:Strings.Text}}"
                                    ToolTip="{Binding [CopyAllInformationAsPlainText], Source={x:Static r:Strings.Text}}" />
                        </WrapPanel>
                        <TextBlock x:Name="SnapshotNote" DockPanel.Dock="Bottom" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <ScrollViewer x:Name="HardwareScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="Sections" />
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem Header="{Binding [InfoGuide], Source={x:Static r:Strings.Text}}">
                    <ScrollViewer x:Name="GuideScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="GuideTopics">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding [InfoGuideTitle], Source={x:Static r:Strings.Text}}" />
                            <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Text="{Binding [InfoGuideIntro], Source={x:Static r:Strings.Text}}" />
                            <Expander IsExpanded="True" Header="{Binding [GuideChartsTitle], Source={x:Static r:Strings.Text}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource GuideIntro}" Text="{Binding [GuideChartsIntro], Source={x:Static r:Strings.Text}}" />
                                    <Viewbox x:Name="ChartsDiagram" Stretch="Uniform" MaxHeight="150" HorizontalAlignment="Left" Margin="0,0,0,14">
                                        <Canvas Width="400" Height="150">
                                            <Canvas.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="Width" Value="20" />
                                                    <Setter Property="Height" Value="20" />
                                                    <Setter Property="CornerRadius" Value="10" />
                                                    <Setter Property="Background" Value="{DynamicResource Surface}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    <Setter Property="BorderThickness" Value="1.5" />
                                                </Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="11" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </Canvas.Resources>
                                            <Rectangle Width="400" Height="150" RadiusX="6" RadiusY="6" Fill="{DynamicResource Raised}" Stroke="{DynamicResource Line}" />
                                            <Rectangle Canvas.Left="12" Canvas.Top="12" Width="84" Height="22" RadiusX="3" RadiusY="3" Stroke="{DynamicResource Line}" />
                                            <Path Canvas.Left="76" Canvas.Top="17" Width="12" Height="12" Data="{x:Static local:ButtonIcon.ChevronDown}" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" />
                                            <Rectangle Canvas.Left="104" Canvas.Top="12" Width="34" Height="22" RadiusX="3" RadiusY="3" Fill="{DynamicResource Line}" />
                                            <Rectangle Canvas.Left="142" Canvas.Top="12" Width="34" Height="22" RadiusX="3" RadiusY="3" Stroke="{DynamicResource Line}" />
                                            <Rectangle Canvas.Left="180" Canvas.Top="12" Width="34" Height="22" RadiusX="3" RadiusY="3" Stroke="{DynamicResource Line}" />
                                            <Rectangle Canvas.Left="320" Canvas.Top="12" Width="68" Height="22" RadiusX="3" RadiusY="3" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" />
                                            <Path Canvas.Left="347" Canvas.Top="16" Width="14" Height="14" Data="{x:Static local:ButtonIcon.Start}" Stretch="Uniform" Stroke="{DynamicResource Text}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                            <Line X1="12" Y1="136" X2="388" Y2="136" Stroke="{DynamicResource Line}" />
                                            <Polyline Points="12,120 50,116 86,118 122,110 158,114 194,108 230,112 262,66 280,52 298,62 322,104 352,110 388,106" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeLineJoin="Round" />
                                            <Polyline Points="12,128 70,126 130,127 190,124 250,126 310,121 360,125 388,124" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                            <Line X1="280" Y1="44" X2="280" Y2="136" Stroke="{DynamicResource Text}" StrokeDashArray="3 3" />
                                            <Ellipse Canvas.Left="276" Canvas.Top="48" Width="8" Height="8" Fill="{DynamicResource Text}" />
                                            <Border Canvas.Left="220" Canvas.Top="13"><TextBlock Text="1" /></Border>
                                            <Border Canvas.Left="250" Canvas.Top="34"><TextBlock Text="2" /></Border>
                                            <Border Canvas.Left="294" Canvas.Top="13"><TextBlock Text="2" /></Border>
                                        </Canvas>
                                    </Viewbox>
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="1"
                                                            Content="{Binding [GuideChartsStep1], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="2" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Start}"
                                                            Content="{Binding [GuideChartsStep2], Source={x:Static r:Strings.Text}}" />
                                    <Button Style="{StaticResource GuideShowMe}" Tag="Charts" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="{Binding [GuideProcessesTitle], Source={x:Static r:Strings.Text}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource GuideIntro}" Text="{Binding [GuideProcessesIntro], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="1"
                                                            Content="{Binding [GuideProcessesStep1], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="2" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Pin}"
                                                            Content="{Binding [GuideProcessesStep2], Source={x:Static r:Strings.Text}}" />
                                    <Button Style="{StaticResource GuideShowMe}" Tag="Processes" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="{Binding [GuideServicesTitle], Source={x:Static r:Strings.Text}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource GuideIntro}" Text="{Binding [GuideServicesIntro], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="1"
                                                            Content="{Binding [GuideServicesStep1], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="2" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Info}"
                                                            Content="{Binding [GuideServicesStep2], Source={x:Static r:Strings.Text}}" />
                                    <Button Style="{StaticResource GuideShowMe}" Tag="Services" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="{Binding [GuideUsageTitle], Source={x:Static r:Strings.Text}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource GuideIntro}" Text="{Binding [GuideUsageIntro], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="1"
                                                            Content="{Binding [GuideUsageStep1], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="2" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Live}"
                                                            Content="{Binding [GuideUsageStep2], Source={x:Static r:Strings.Text}}" />
                                    <Button Style="{StaticResource GuideShowMe}" Tag="Usage" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="{Binding [GuideConnectionsTitle], Source={x:Static r:Strings.Text}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource GuideIntro}" Text="{Binding [GuideConnectionsIntro], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="1" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Info}"
                                                            Content="{Binding [GuideConnectionsStep1], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="2" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Pin}"
                                                            Content="{Binding [GuideConnectionsStep2], Source={x:Static r:Strings.Text}}" />
                                    <Button Style="{StaticResource GuideShowMe}" Tag="Connections" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="{Binding [GuideExportTitle], Source={x:Static r:Strings.Text}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource GuideIntro}" Text="{Binding [GuideExportIntro], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="1" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Copy}"
                                                            Content="{Binding [GuideExportStep1], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="2" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Download}"
                                                            Content="{Binding [GuideExportStep2], Source={x:Static r:Strings.Text}}" />
                                    <Button Style="{StaticResource GuideShowMe}" Tag="Export" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="{Binding [GuideAutomaticTitle], Source={x:Static r:Strings.Text}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource GuideIntro}" Text="{Binding [GuideAutomaticIntro], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="1" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Settings}"
                                                            Content="{Binding [GuideAutomaticStep1], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="2" local:ButtonIcon.Data="{x:Static local:ButtonIcon.CaptureFrame}"
                                                            Content="{Binding [GuideAutomaticStep2], Source={x:Static r:Strings.Text}}" />
                                    <Button Style="{StaticResource GuideShowMe}" Tag="Automatic" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="{Binding [GuideCompactTitle], Source={x:Static r:Strings.Text}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource GuideIntro}" Text="{Binding [GuideCompactIntro], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="1" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Compact}"
                                                            Content="{Binding [GuideCompactStep1], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="2" local:ButtonIcon.Data="{x:Static local:ButtonIcon.AlwaysOnTop}"
                                                            Content="{Binding [GuideCompactStep2], Source={x:Static r:Strings.Text}}" />
                                    <Button Style="{StaticResource GuideShowMe}" Tag="Compact" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="{Binding [GuideWalkthroughTitle], Source={x:Static r:Strings.Text}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource GuideIntro}" Text="{Binding [GuideWalkthroughIntro], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="1"
                                                            Content="{Binding [GuideWalkthroughStep1], Source={x:Static r:Strings.Text}}" />
                                    <HeaderedContentControl Style="{StaticResource GuideStep}" Header="2" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Copy}"
                                                            Content="{Binding [GuideWalkthroughStep2], Source={x:Static r:Strings.Text}}" />
                                    <Button Style="{StaticResource GuideShowMe}" Tag="Walkthrough" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{Binding [InfoAbout], Source={x:Static r:Strings.Text}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel Margin="8,12,8,28">
                                <TextBlock Text="{Binding [WinMon], Source={x:Static r:Strings.Text}}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,8,0,16" />
                                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock x:Name="LicenseText" TextWrapping="Wrap" TextAlignment="Center" Margin="0,20,0,8" Foreground="{DynamicResource Muted}" />
                                <TextBlock TextAlignment="Center" TextWrapping="Wrap">
                                    <Hyperlink x:Name="RepositoryLink" Foreground="{DynamicResource Accent}" RequestNavigate="OnRepositoryNavigate"
                                               AutomationProperties.Name="{Binding [WinMonSourceCodeOnGitHub], Source={x:Static r:Strings.Text}}" />
                                </TextBlock>
                            </StackPanel>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding [Updates], Source={x:Static r:Strings.Text}}" />
                                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Body}" AutomationProperties.LiveSetting="Polite" />
                                    <WrapPanel>
                                        <Button x:Name="CheckButton" Click="OnCheckForUpdates" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Live}"
                                                Content="{Binding [CheckForUpdates], Source={x:Static r:Strings.Text}}" />
                                        <Button x:Name="UpdateButton" Margin="8,0,0,0" Click="OnUpdate" Visibility="Collapsed"
                                                BorderBrush="{DynamicResource Accent}"
                                                ToolTip="{Binding [UpdateNowHelp], Source={x:Static r:Strings.Text}}"
                                                Content="{Binding [UpdateNow], Source={x:Static r:Strings.Text}}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Button x:Name="OpenLogsButton" HorizontalAlignment="Left" Margin="0,20,0,0"
                                    Click="OnOpenLogs"
                                    ToolTip="{Binding [OpenLogsFolderHelp], Source={x:Static r:Strings.Text}}"
                                    Content="{Binding [OpenLogsFolder], Source={x:Static r:Strings.Text}}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
