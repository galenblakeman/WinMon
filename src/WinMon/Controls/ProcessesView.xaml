<UserControl
    x:Class="WinMon.Controls.ProcessesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WinMon.Controls"
    xmlns:resources="clr-namespace:WinMon.Resources">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="108" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            x:Name="ProcessHeader"
            Grid.Row="0"
            Margin="-20,0,-20,8"
            Padding="20,5"
            Background="{DynamicResource SectionHeaderSurface}"
            BorderBrush="{DynamicResource Line}"
            BorderThickness="0">
            <StackPanel>
                <Grid x:Name="ProcessToolbarGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        x:Name="ProcessGroupingControls"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding [ProcessGrouping], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                        Orientation="Horizontal">
                        <RadioButton
                            x:Name="IndividualChip"
                            AutomationProperties.Name="{Binding [OneRowPerProcess], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                            Content="{Binding [Individual], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                            GroupName="ProcessGrouping"
                            IsChecked="True"
                            Style="{StaticResource RangeChip}"
                            ToolTip="{Binding [OneRowPerProcess], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                        <RadioButton
                            x:Name="GroupedChip"
                            Margin="0"
                            AutomationProperties.Name="{Binding [OneRowPerExecutable], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                            Content="{Binding [Grouped], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                            GroupName="ProcessGrouping"
                            Style="{StaticResource RangeChip}"
                            ToolTip="{Binding [OneRowPerExecutableCPUAndIOSummedGPU], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        x:Name="ProcessRankingControls"
                        Grid.Row="0"
                        Grid.Column="0"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{Binding [Top], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                        <ComboBox
                            x:Name="ProcessCountSelector"
                            MinWidth="60"
                            MinHeight="28"
                            Margin="6,0"
                            Padding="6,3,24,3"
                            AutomationProperties.Name="{Binding [NumberOfTopProcesses], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            ToolTip="{Binding [NumberOfProcessesShown], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{Binding [ProcessesBy], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                        <ComboBox
                            x:Name="ProcessSortSelector"
                            MinWidth="90"
                            MinHeight="28"
                            Margin="6,0,0,0"
                            Padding="8,3,26,3"
                            AutomationProperties.Name="{Binding [RankProcessesBy], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            ToolTip="{Binding [RankByFiveSecondAverageCPUGPUOrIO], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                    </StackPanel>
                    <Border
                        x:Name="ProcessSearchBorder"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        MinWidth="120"
                        Margin="0,6,12,0"
                        Background="{DynamicResource SearchSurface}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="{DynamicResource Muted}"
                                IsHitTestVisible="False"
                                Text="{Binding [SearchGlyph], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                            <TextBox
                                x:Name="ProcessSearchBox"
                                Grid.Column="1"
                                MinHeight="26"
                                Padding="0,3"
                                VerticalContentAlignment="Center"
                                AutomationProperties.Name="{Binding [SearchProcessesByNameOrPID], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                Background="Transparent"
                                BorderThickness="0"
                                CaretBrush="{DynamicResource Text}"
                                FontSize="12"
                                Foreground="{DynamicResource Text}"
                                HorizontalScrollBarVisibility="Hidden"
                                ToolTip="{Binding [FilterRankedProcessesByNameOrPIDCtrlFEscape], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                            <TextBlock
                                x:Name="ProcessSearchPlaceholder"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource Muted}"
                                IsHitTestVisible="False"
                                Text="{Binding [SearchNameOrPID], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="ClearProcessSearchButton"
                                Grid.Column="2"
                                Width="28"
                                MinHeight="26"
                                Margin="0"
                                Padding="0"
                                controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.Cancel}"
                                AutomationProperties.Name="{Binding [ClearProcessSearch], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnClearProcessSearch"
                                ToolTip="{Binding [ClearSearch], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <CheckBox
                        x:Name="AppsOnlyCheckBox"
                        Grid.Row="1"
                        Grid.Column="3"
                        Margin="0,6,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding [AppOnly], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                        Content="{Binding [AppOnly], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{DynamicResource Text}"
                        ToolTip="{Binding [ProcessKindExplanation], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                    <CheckBox
                        x:Name="PinnedOnlyCheckBox"
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="{Binding [PinnedOnly], Source={x:Static resources:Strings.Text}}"
                        Content="{Binding [PinnedOnly], Source={x:Static resources:Strings.Text}}"
                        FontSize="12"
                        Foreground="{DynamicResource Text}"
                        ToolTip="{Binding [PinnedProcessesExplanation], Source={x:Static resources:Strings.Text}}" />
                </Grid>
                <TextBlock
                    x:Name="SelectionLabel"
                    Margin="0,4,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource Muted}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <Grid
            Grid.Row="1"
            Width="{Binding ViewportWidth, ElementName=ProcessScroll}"
            Margin="0,0,0,5"
            HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="55" />
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="95" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="66" />
            </Grid.ColumnDefinitions>
            <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource Muted}"
                    Text="{Binding [ProcessColumn], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                <TextBlock
                    x:Name="CoverageLabel"
                    Grid.Column="1"
                    Margin="10,0,4,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource Muted}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding [UnattributedCPUIsTotalCPUMinusAllMeasuredProcessesKernel2], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
                <StackPanel
                    x:Name="PinSummary"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <TextBlock
                        Margin="2,0,6,0"
                        FontSize="11"
                        Foreground="{DynamicResource Muted}"
                        Text="·" />
                    <TextBlock
                        x:Name="PinnedCountLabel"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource ProcessPinAccent}" />
                </StackPanel>
            </Grid>
            <TextBlock
                x:Name="ProcessHistoryHeader"
                Grid.Column="1"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource Muted}"
                Text="{Binding [History], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                ToolTip="{Binding [CPUHistoryOnOneScaleSharedByEveryRowHover], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
            <TextBlock
                x:Name="CpuHeader"
                Grid.Column="2"
                HorizontalAlignment="Right"
                FontSize="12"
                Foreground="{DynamicResource Muted}"
                Text="{Binding [CPU], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                ToolTip="{Binding [AverageOverTheLast5SecondsWindowsCountsProcessCPU], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
            <TextBlock
                x:Name="GpuHeader"
                Grid.Column="3"
                HorizontalAlignment="Right"
                FontSize="12"
                Foreground="{DynamicResource Muted}"
                Text="{Binding [GPU], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                ToolTip="{Binding [BusiestGPUEnginePerProcessAveragedOverReadableIntervalsIn], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
            <TextBlock
                x:Name="MemoryHeader"
                Grid.Column="4"
                HorizontalAlignment="Right"
                FontSize="12"
                Foreground="{DynamicResource Muted}"
                Text="{Binding [Memory], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                ToolTip="{Binding [ResidentWorkingSetIncludingSharedPages], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
            <TextBlock
                x:Name="IoHeader"
                Grid.Column="5"
                HorizontalAlignment="Right"
                FontSize="12"
                Foreground="{DynamicResource Muted}"
                Text="{Binding [IO], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                ToolTip="{Binding [ProcessReadWriteIOIncludesFileNetworkAndDevice], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
            <TextBlock
                x:Name="ThreadsHeader"
                Grid.Column="6"
                HorizontalAlignment="Right"
                FontSize="12"
                Foreground="{DynamicResource Muted}"
                Text="{Binding [Threads], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                ToolTip="{Binding [ProcessThreadsExplanation], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
            <TextBlock
                x:Name="HandlesHeader"
                Grid.Column="7"
                HorizontalAlignment="Right"
                FontSize="12"
                Foreground="{DynamicResource Muted}"
                Text="{Binding [Handles], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
                ToolTip="{Binding [ProcessHandlesExplanation], Source={x:Static resources:Strings.Text}, Mode=OneWay}" />
        </Grid>
        <ScrollViewer
            x:Name="ProcessScroll"
            Grid.Row="2"
            Padding="0,0,0,0"
            Focusable="False"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ProcessRows">
                <StackPanel x:Name="PinnedProcessRows" />
                <Border
                    x:Name="RankedDivider"
                    Padding="0,5"
                    BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="RankedDividerText"
                        FontSize="11"
                        Foreground="{DynamicResource Muted}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
        <controls:ActionDrawer x:Name="ProcessActionDrawer" Grid.Row="3">
            <controls:ProcessActionBar x:Name="ProcessActions" />
        </controls:ActionDrawer>
        <TextBlock
            x:Name="EmptyLabel"
            Grid.Row="2"
            Margin="0,8"
            VerticalAlignment="Center"
            Foreground="{DynamicResource Muted}"
            Text="{Binding [CollectingTheFirstInterval], Source={x:Static resources:Strings.Text}, Mode=OneWay}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
