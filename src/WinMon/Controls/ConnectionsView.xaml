<UserControl x:Class="WinMon.Controls.ConnectionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WinMon.Controls" xmlns:r="clr-namespace:WinMon.Resources" Foreground="{DynamicResource Text}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="3" Margin="0,0,0,8" Padding="20,5" Background="{DynamicResource SectionHeaderSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SearchBorder" MinWidth="180" Margin="0,0,12,0" Background="{DynamicResource SearchSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Text="{Binding [SearchGlyph], Source={x:Static r:Strings.Text}}" />
                        <TextBox x:Name="Search" Grid.Column="1" MinHeight="26" Padding="0,3" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding [ConnectionsSearch], Source={x:Static r:Strings.Text}}" Background="{DynamicResource SearchSurface}" BorderThickness="0" CaretBrush="{DynamicResource Text}" FontSize="12" Foreground="{DynamicResource Text}" TextChanged="OnSearchChanged" ToolTip="{Binding [ConnectionsSearch], Source={x:Static r:Strings.Text}}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Text="{Binding [ConnectionsSearch], Source={x:Static r:Strings.Text}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding [ConnectionsProtocol], Source={x:Static r:Strings.Text}}" />
                    <ComboBox x:Name="Protocol" Width="90" MinHeight="28" AutomationProperties.Name="{Binding [ConnectionsProtocol], Source={x:Static r:Strings.Text}}" FontSize="12" SelectionChanged="OnProtocolChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="IndividualChip" GroupName="ConnectionGrouping" Style="{DynamicResource RangeChip}"
                                 Content="{Binding [Individual], Source={x:Static r:Strings.Text}}"
                                 ToolTip="{Binding [ConnectionsIndividualHelp], Source={x:Static r:Strings.Text}}" Checked="OnGroupingChanged" />
                    <RadioButton x:Name="GroupedChip" GroupName="ConnectionGrouping" Style="{DynamicResource RangeChip}"
                                 IsChecked="True" Content="{Binding [Grouped], Source={x:Static r:Strings.Text}}"
                                 ToolTip="{Binding [ConnectionsGroupedHelp], Source={x:Static r:Strings.Text}}" Checked="OnGroupingChanged" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Grid.Row="1" Margin="0,0,18,4" MinWidth="740">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Foreground="{DynamicResource Muted}" Text="{Binding [ConnectionsProcess], Source={x:Static r:Strings.Text}}" />
            <TextBlock Grid.Column="1" Foreground="{DynamicResource Muted}" Text="{Binding [ConnectionsLocalEndpoint], Source={x:Static r:Strings.Text}}" />
            <TextBlock Grid.Column="2" Foreground="{DynamicResource Muted}" Text="{Binding [ConnectionsRemoteEndpoint], Source={x:Static r:Strings.Text}}" />
            <TextBlock Grid.Column="3" Foreground="{DynamicResource Muted}" Text="{Binding [ConnectionsState], Source={x:Static r:Strings.Text}}" />
            <TextBlock Grid.Column="4" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" Text="TCP" />
            <TextBlock Grid.Column="5" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" Text="UDP" />
        </Grid>
        <ListBox x:Name="Rows" Grid.Column="1" Grid.Row="2" Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding [ConnectionsTab], Source={x:Static r:Strings.Text}}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}" SelectionChanged="OnSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Selection" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Selection" Property="Background" Value="{DynamicResource Raised}" />
                                        <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="Selection" Property="BorderThickness" Value="1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ConnectionDisplayRow}">
                    <Border Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinWidth="758">
                        <Grid MinHeight="{Binding MinimumHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Margin="{Binding Indent}" VerticalAlignment="Center">
                                <Button Width="26" MinHeight="26" Margin="0,0,4,0" Padding="0" AutomationProperties.Name="{Binding ExpandLabel}" Background="Transparent" BorderThickness="0" Click="OnExpand" Content="{Binding ExpandGlyph}" Visibility="{Binding ExpandVisibility}" />
                                <Image Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding Icon}" Visibility="{Binding IconVisibility}" />
                                <StackPanel>
                                    <TextBlock FontSize="13" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <TextBlock FontSize="10" Foreground="{DynamicResource Muted}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Text="{Binding Local}" ToolTip="{Binding LocalToolTip}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Text="{Binding Remote}" ToolTip="{Binding RemoteToolTip}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" Text="{Binding State}" ToolTip="{Binding StateToolTip}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Text="{Binding Tcp}" />
                            <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Text="{Binding Udp}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Notice" Grid.Column="1" Grid.Row="3" Margin="0,6,0,4" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" />
        <TextBlock Grid.Column="1" Grid.Row="4" Margin="0,4,0,6" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Text="{Binding [ConnectionsNote], Source={x:Static r:Strings.Text}}" />
        <local:ActionDrawer x:Name="ActionsDrawer" Grid.Column="1" Grid.Row="5">
            <Border MinHeight="54" Background="{DynamicResource SectionHeaderSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource Accent}" CornerRadius="3,0,0,3" />
                    <DockPanel Grid.Column="1" Margin="14,6">
                        <Image x:Name="SelectionIcon" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <StackPanel>
                            <TextBlock x:Name="SelectionName" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SelectionDetail" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Column="2" Margin="0,6,14,6" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button x:Name="CopyDetails" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Copy}" Click="OnCopyDetails" Content="{Binding [CopyDetails], Source={x:Static r:Strings.Text}}" Style="{DynamicResource ActionBarButton}" />
                        <Button x:Name="ShowProcess" Margin="8,0,0,0" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Process}" Click="OnShowProcess" Content="{Binding [ConnectionsShowProcess], Source={x:Static r:Strings.Text}}" Style="{DynamicResource ActionBarLastButton}" />
                        <Border Style="{DynamicResource ActionBarDivider}" />
                        <Button Style="{DynamicResource ActionBarCollapseButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </local:ActionDrawer>
    </Grid>
</UserControl>
