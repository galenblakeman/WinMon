<UserControl x:Class="WinMon.Controls.ConnectionsView" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WinMon.Controls" xmlns:r="clr-namespace:WinMon.Resources" Foreground="{DynamicResource Text}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="3" Margin="0,0,0,8" Padding="8,5" Background="{DynamicResource SectionHeaderSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding [Top], Source={x:Static r:Strings.Text}}" />
                    <ComboBox x:Name="TopCount" MinWidth="60" MinHeight="28" Margin="4,0,8,0" AutomationProperties.Name="{Binding [ConnectionsTop], Source={x:Static r:Strings.Text}}" SelectionChanged="OnSettingsChanged" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding [UsageAppsBy], Source={x:Static r:Strings.Text}}" />
                    <ComboBox x:Name="Rank" MinWidth="90" MinHeight="28" Margin="4,0,0,0" AutomationProperties.Name="{Binding [ConnectionsRankBy], Source={x:Static r:Strings.Text}}" SelectionChanged="OnSettingsChanged" />
                </StackPanel>
                <Border x:Name="SearchBorder" Grid.Column="1" MinWidth="60" Margin="8,0" Background="{DynamicResource SearchSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Text="{Binding [SearchGlyph], Source={x:Static r:Strings.Text}}" />
                        <TextBox x:Name="Search" Grid.Column="1" MinHeight="26" Padding="0,3" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding [ConnectionsSearch], Source={x:Static r:Strings.Text}}" Background="{DynamicResource SearchSurface}" BorderThickness="0" CaretBrush="{DynamicResource Text}" FontSize="12" Foreground="{DynamicResource Text}" TextChanged="OnSearchChanged" ToolTip="{Binding [ConnectionsSearch], Source={x:Static r:Strings.Text}}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Text="{Binding [ConnectionsSearch], Source={x:Static r:Strings.Text}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="ClearConnectionSearchButton" Grid.Column="2" Width="28" MinHeight="26" Margin="0" Padding="0" HorizontalAlignment="Right" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Cancel}" AutomationProperties.Name="{Binding [ClearSearch], Source={x:Static r:Strings.Text}}" Background="Transparent" BorderThickness="0" Click="OnClearSearch" ToolTip="{Binding [ClearSearch], Source={x:Static r:Strings.Text}}" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <CheckBox x:Name="AppsOnly" Grid.Column="2" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource Text}" ToolTip="{Binding [ProcessKindExplanation], Source={x:Static r:Strings.Text}}" VerticalAlignment="Center" Content="{Binding [AppOnly], Source={x:Static r:Strings.Text}}" AutomationProperties.Name="{Binding [AppOnly], Source={x:Static r:Strings.Text}}" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
                <CheckBox x:Name="PinnedOnly" ToolTip="{Binding [PinnedOnlyHelp], Source={x:Static r:Strings.Text}}" AutomationProperties.HelpText="{Binding [PinnedOnlyHelp], Source={x:Static r:Strings.Text}}" Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Text}" Content="{Binding [PinnedOnly], Source={x:Static r:Strings.Text}}" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
                <ComboBox x:Name="TrafficPeriod" Grid.Column="4" Width="112" MinHeight="28" Margin="0" FontSize="12" AutomationProperties.Name="{Binding [ConnectionsTrafficPeriod], Source={x:Static r:Strings.Text}}" ToolTip="{Binding [ConnectionsTrafficHelp], Source={x:Static r:Strings.Text}}" SelectionChanged="OnSettingsChanged" />
            </Grid>
        </Border>
        <Border x:Name="TrafficPrompt" Grid.Column="1" Grid.Row="1" Margin="0,0,0,8" MinHeight="64" Background="{DynamicResource SectionHeaderSurface}" CornerRadius="4" Visibility="Collapsed" SizeChanged="OnTrafficPromptSizeChanged">
            <Grid>
                <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource Accent}" CornerRadius="4,0,0,4" />
                <!-- Named part retained for bindings and diagnostic inspection. -->
                <!-- ReSharper disable once UnusedMember.Global -->
                <Grid x:Name="TrafficPromptLayout" Margin="17,10,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="TrafficPromptText" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding [ConnectionsTrafficMonitoringOff], Source={x:Static r:Strings.Text}}" />
                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Text="{Binding [ConnectionsTrafficMonitoringBenefit], Source={x:Static r:Strings.Text}}" />
                    </StackPanel>
                    <Button x:Name="EnableTrafficMonitoring" Grid.Row="0" Grid.Column="1" MinHeight="36" Margin="0" Padding="14,6" VerticalAlignment="Center" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentButtonText}" FontSize="13" FontWeight="SemiBold" Click="OnTrafficSettings" AutomationProperties.Name="{Binding [ConnectionsEnableTrafficMonitoring], Source={x:Static r:Strings.Text}}" AutomationProperties.HelpText="{Binding [ConnectionsTrafficMonitoringBenefit], Source={x:Static r:Strings.Text}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="FocusVisualStyle">
                                    <Setter.Value>
                                        <Style TargetType="Control">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Control">
                                                        <Rectangle Margin="-3" Stroke="{DynamicResource Text}" StrokeThickness="2" StrokeDashArray="2,1" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock x:Name="TrafficMonitoringLabel" Foreground="{Binding Foreground, ElementName=EnableTrafficMonitoring}" Text="{Binding [ConnectionsEnableTrafficMonitoring], Source={x:Static r:Strings.Text}}" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
        <ScrollViewer x:Name="HeaderScroller" Grid.Column="1" Grid.Row="2" Margin="0,0,18,4" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid x:Name="ConnectionHeaders" MinWidth="650" ToolTip="{Binding Text, ElementName=Notice}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition x:Name="ReceiveHeaderColumn" Width="0" />
                <ColumnDefinition x:Name="SendHeaderColumn" Width="0" />
                <ColumnDefinition x:Name="ReceivedHeaderColumn" Width="0" />
                <ColumnDefinition x:Name="SentHeaderColumn" Width="0" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource Muted}" Text="{Binding [ConnectionsProcess], Source={x:Static r:Strings.Text}}" />
                <StackPanel x:Name="PinSummary" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Margin="2,0,6,0" FontSize="11" Foreground="{DynamicResource Muted}" Text="·" />
                    <TextBlock x:Name="PinnedCountLabel" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ProcessPinAccent}" ToolTip="{Binding [PinnedOnlyHelp], Source={x:Static r:Strings.Text}}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="1" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" Text="{Binding [History], Source={x:Static r:Strings.Text}}" ToolTip="{Binding [ConnectionsHistoryHelp], Source={x:Static r:Strings.Text}}" />
            <TextBlock x:Name="ReceiveHeader" Grid.Column="2" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" Text="{Binding [ConnectionsReceiveRate], Source={x:Static r:Strings.Text}}" Visibility="Collapsed" />
            <TextBlock x:Name="SendHeader" Grid.Column="3" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" Text="{Binding [ConnectionsSendRate], Source={x:Static r:Strings.Text}}" Visibility="Collapsed" />
            <TextBlock x:Name="ReceivedHeader" Grid.Column="4" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" Text="{Binding [ConnectionsReceived], Source={x:Static r:Strings.Text}}" ToolTip="{Binding [ConnectionsTrafficHelp], Source={x:Static r:Strings.Text}}" Visibility="Collapsed" />
            <TextBlock x:Name="SentHeader" Grid.Column="5" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" Text="{Binding [ConnectionsSent], Source={x:Static r:Strings.Text}}" ToolTip="{Binding [ConnectionsTrafficHelp], Source={x:Static r:Strings.Text}}" Visibility="Collapsed" />
            <TextBlock Grid.Column="6" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" Text="TCP" />
            <TextBlock Grid.Column="7" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" Text="UDP" />
        </Grid>
        </ScrollViewer>
        <ListBox x:Name="Rows" Grid.Column="1" Grid.Row="3" Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding [ConnectionsTab], Source={x:Static r:Strings.Text}}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnProperties" ScrollViewer.ScrollChanged="OnRowsScrollChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                    <Setter Property="AutomationProperties.HelpText" Value="{Binding RankedLabel}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid>
                                    <Border x:Name="Selection" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                                        <ContentPresenter />
                                    </Border>
                                    <Border x:Name="FocusOutline" BorderBrush="{DynamicResource Accent}" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Selection" Property="Background" Value="{DynamicResource Raised}" />
                                        <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ConnectionDisplayRow}">
                    <Border Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinWidth="{Binding ConnectionRowMinWidth, RelativeSource={RelativeSource AncestorType={x:Type local:ConnectionsView}}}">
                        <Grid MinHeight="46">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" MinHeight="46" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="{Binding ReceiveColumnWidth}" />
                                <ColumnDefinition Width="{Binding SendColumnWidth}" />
                                <ColumnDefinition Width="{Binding TotalColumnWidth}" />
                                <ColumnDefinition Width="{Binding TotalColumnWidth}" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="8" Padding="0,5" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Visibility="{Binding RankedVisibility}">
                                <TextBlock FontSize="11" Foreground="{DynamicResource Muted}" Text="{Binding RankedLabel}" />
                            </Border>
                            <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,4,8,4" VerticalAlignment="Center">
                                <Button Width="26" MinHeight="26" Margin="0,0,4,0" Padding="0" AutomationProperties.Name="{Binding PinAccessibleName}" ToolTip="{Binding PinLabel}" IsEnabled="{Binding CanPin}" Background="Transparent" BorderThickness="0" Click="OnPin">
                                    <Path Width="12" Height="12" Stretch="Uniform" Data="{Binding PinIcon}">
                                        <Path.Style><Style TargetType="Path"><Setter Property="Fill" Value="{DynamicResource Muted}" /><Style.Triggers><DataTrigger Binding="{Binding Pinned}" Value="True"><Setter Property="Fill" Value="{DynamicResource ProcessPinAccent}" /></DataTrigger></Style.Triggers></Style></Path.Style>
                                    </Path>
                                </Button>
                                <Image Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Source="{Binding Icon}" />
                                <StackPanel>
                                    <TextBlock FontSize="13" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <TextBlock FontSize="10" Foreground="{DynamicResource Muted}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                </StackPanel>
                            </DockPanel>
                            <ContentControl Grid.Row="1" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Content="{Binding Graph}" ToolTip="{Binding [ConnectionsHistoryHelp], Source={x:Static r:Strings.Text}}" AutomationProperties.Name="{Binding [ConnectionsHistoryHelp], Source={x:Static r:Strings.Text}}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Text="{Binding Receive}" ToolTip="{Binding NetworkToolTip}" Visibility="{Binding NetworkVisibility}" />
                            <TextBlock Grid.Row="1" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Text="{Binding Send}" ToolTip="{Binding NetworkToolTip}" Visibility="{Binding NetworkVisibility}" />
                            <TextBlock Grid.Row="1" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Text="{Binding Received}" AutomationProperties.Name="{Binding TrafficAccessibleName}" ToolTip="{Binding TrafficToolTip}" Visibility="{Binding NetworkVisibility}" />
                            <TextBlock Grid.Row="1" Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Text="{Binding Sent}" AutomationProperties.Name="{Binding TrafficAccessibleName}" ToolTip="{Binding TrafficToolTip}" Visibility="{Binding NetworkVisibility}" />
                            <TextBlock Grid.Row="1" Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Text="{Binding Tcp}" />
                            <TextBlock Grid.Row="1" Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Text="{Binding Udp}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="1" Grid.Row="4">
            <TextBlock x:Name="Notice" Margin="0,6,0,4" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
        <local:ActionDrawer x:Name="ActionsDrawer" Grid.Column="1" Grid.Row="5">
            <Border x:Name="ActionBar" MinHeight="54" Background="{DynamicResource SectionHeaderSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource Accent}" CornerRadius="3,0,0,3" />
                    <DockPanel Grid.Column="1" Margin="14,6">
                        <Image x:Name="SelectionIcon" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SelectionName" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SelectionDetail" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Column="2" Margin="0,6,14,6" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button x:Name="Properties" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Info}" Click="OnProperties" Content="{Binding [Properties], Source={x:Static r:Strings.Text}}" Style="{DynamicResource ActionBarButton}" />
                        <Button x:Name="CopyDetails" Margin="8,0,0,0" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Copy}" Click="OnCopyDetails" Content="{Binding [CopyDetails], Source={x:Static r:Strings.Text}}" Style="{DynamicResource ActionBarButton}" />
                        <Button x:Name="ShowProcess" Margin="8,0,0,0" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Process}" Click="OnShowProcess" Content="{Binding [ConnectionsShowProcess], Source={x:Static r:Strings.Text}}" Style="{DynamicResource ActionBarLastButton}" />
                        <Border Style="{DynamicResource ActionBarDivider}" />
                        <Button Style="{DynamicResource ActionBarCollapseButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </local:ActionDrawer>
    </Grid>
</UserControl>
