<UserControl
    x:Class="WinMon.Controls.UsageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WinMon.Controls"
    xmlns:r="clr-namespace:WinMon.Resources"
    Foreground="{DynamicResource Text}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            Margin="-20,0,-20,8"
            Padding="20,5"
            Background="{DynamicResource SectionHeaderSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                x:Name="RankingControls"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding [Top], Source={x:Static r:Strings.Text}}" />
                <ComboBox
                    x:Name="TopCount"
                    MinWidth="60"
                    MinHeight="28"
                    Margin="6,0"
                    Padding="6,3,24,3"
                    AutomationProperties.Name="{Binding [UsageNumberOfApps], Source={x:Static r:Strings.Text}}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    SelectionChanged="OnSettingsChanged"
                    ToolTip="{Binding [UsageNumberOfApps], Source={x:Static r:Strings.Text}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding [UsageAppsBy], Source={x:Static r:Strings.Text}}" />
                <ComboBox
                    x:Name="Sort"
                    MinWidth="110"
                    MinHeight="28"
                    Margin="6,0,0,0"
                    Padding="8,3,26,3"
                    AutomationProperties.Name="{Binding [UsageSort], Source={x:Static r:Strings.Text}}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    SelectionChanged="OnSettingsChanged" />
            </StackPanel>
            <Border
                x:Name="SearchBorder"
                Grid.Row="0"
                Grid.Column="1"
                MinWidth="160"
                Margin="12,0"
                Background="{DynamicResource SearchSurface}"
                BorderThickness="1"
                CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Foreground="{DynamicResource Muted}"
                        IsHitTestVisible="False"
                        Text="{Binding [SearchGlyph], Source={x:Static r:Strings.Text}}" />
                    <TextBox
                        x:Name="Search"
                        Grid.Column="1"
                        MinHeight="26"
                        Padding="0,3"
                        VerticalContentAlignment="Center"
                        AutomationProperties.Name="{Binding [UsageSearch], Source={x:Static r:Strings.Text}}"
                        Background="{DynamicResource SearchSurface}"
                        BorderThickness="0"
                        CaretBrush="{DynamicResource Text}"
                        FontSize="12"
                        Foreground="{DynamicResource Text}"
                        TextChanged="OnSearchChanged"
                        ToolTip="{Binding [UsageSearch], Source={x:Static r:Strings.Text}}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Muted}"
                        IsHitTestVisible="False"
                        Text="{Binding [UsageSearch], Source={x:Static r:Strings.Text}}"
                        TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button
                        x:Name="ClearSearchButton"
                        Grid.Column="2"
                        Width="28"
                        MinHeight="26"
                        Padding="0"
                        local:ButtonIcon.Data="{x:Static local:ButtonIcon.Cancel}"
                        AutomationProperties.Name="{Binding [ClearSearch], Source={x:Static r:Strings.Text}}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnClearSearch"
                        ToolTip="{Binding [ClearSearch], Source={x:Static r:Strings.Text}}"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
            <CheckBox
                x:Name="AppsOnly"
                Grid.Row="0"
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding [AppOnly], Source={x:Static r:Strings.Text}}"
                Checked="OnSettingsChanged"
                Content="{Binding [AppOnly], Source={x:Static r:Strings.Text}}"
                FontSize="12"
                Foreground="{DynamicResource Text}"
                ToolTip="{Binding [ProcessKindExplanation], Source={x:Static r:Strings.Text}}"
                Unchecked="OnSettingsChanged" />
            <StackPanel
                x:Name="UsageActions"
                Grid.Row="0"
                Grid.Column="3"
                Margin="12,0,0,0"
                Orientation="Horizontal">
                <Button
                    x:Name="CopyUsage"
                    local:ButtonIcon.Data="{x:Static local:ButtonIcon.Copy}"
                    Click="OnCopyUsage"
                    Content="{Binding [UsageCopy], Source={x:Static r:Strings.Text}}"
                    Style="{DynamicResource ActionBarButton}" />
                <Button
                    x:Name="ResetUsage"
                    local:ButtonIcon.Data="{x:Static local:ButtonIcon.Live}"
                    Click="OnReset"
                    Content="{Binding [UsageReset], Source={x:Static r:Strings.Text}}"
                    Style="{DynamicResource ActionBarLastButton}"
                    ToolTip="{Binding [UsageResetConfirm], Source={x:Static r:Strings.Text}}" />
            </StackPanel>
        </Grid>
        </Border>
        <ScrollViewer
            x:Name="HeaderScroll"
            Grid.Row="1"
            HorizontalAlignment="Left"
            Focusable="False"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Disabled">
            <Grid
                x:Name="ColumnHeaders"
                MinWidth="560"
                Margin="0,0,18,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="84" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Foreground="{DynamicResource Muted}"
                    Text="{Binding [UsageApp], Source={x:Static r:Strings.Text}}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="CpuHeader"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnRankHeader" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Foreground="{DynamicResource Muted}"
                    Text="{Binding [UsageShare], Source={x:Static r:Strings.Text}}"
                    ToolTip="{Binding [UsageShareHelp], Source={x:Static r:Strings.Text}}" />
                <TextBlock
                    x:Name="IoHeader"
                    Grid.Column="3"
                    HorizontalAlignment="Right"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnRankHeader" />
                <TextBlock
                    x:Name="GpuHeader"
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnRankHeader" />
                <TextBlock
                    x:Name="ProcessesHeader"
                    Grid.Column="5"
                    HorizontalAlignment="Right"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnRankHeader" />
                <TextBlock
                    x:Name="LastActiveHeader"
                    Grid.Column="6"
                    HorizontalAlignment="Right"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnRankHeader" />
            </Grid>
        </ScrollViewer>
        <ListBox
            x:Name="Rows"
            Grid.Row="2"
            Padding="0"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.Name="{Binding [UsageTab], Source={x:Static r:Strings.Text}}"
            Background="Transparent"
            BorderThickness="0"
            ContextMenuOpening="OnMenuOpening"
            Foreground="{DynamicResource Text}"
            PreviewMouseRightButtonDown="OnRowRightClick"
            SelectionChanged="OnSelectionChanged"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.ScrollChanged="OnScrollChanged"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="Selection"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="0,0,0,1">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Selection" Property="Background" Value="{DynamicResource Raised}" />
                                        <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="Selection" Property="BorderThickness" Value="1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:UsageDisplayRow}">
                    <!--  Constrain star sizing to the viewport despite the horizontally scrollable list (560 + 18 gutter).  -->
                    <Border Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinWidth="578">
                        <Grid MinHeight="42" Margin="0,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <DockPanel
                                Margin="0,4,8,4"
                                VerticalAlignment="Center"
                                ClipToBounds="True">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Margin="2,0,8,0"
                                    VerticalAlignment="Center"
                                    Source="{Binding Icon}" />
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Tooltip}" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource Muted}"
                                        Text="{Binding Detail}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Tooltip}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding CpuTime}" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding Share}" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding Io}" />
                            <TextBlock
                                Grid.Column="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding GpuTime}" />
                            <TextBlock
                                Grid.Column="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding Processes}" />
                            <TextBlock
                                Grid.Column="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding LastActive}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid
            x:Name="NotAttributedRow"
            Grid.Row="3"
            MinWidth="560"
            Margin="0,2,18,0"
            Background="Transparent"
            ToolTip="{Binding [UsageNotAttributedHelp], Source={x:Static r:Strings.Text}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="84" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Margin="26,6,0,6"
                FontSize="12"
                Foreground="{DynamicResource Muted}"
                Text="{Binding [UsageNotAttributed], Source={x:Static r:Strings.Text}}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="NotAttributedCpu"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource Muted}" />
            <TextBlock
                x:Name="NotAttributedShare"
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource Muted}" />
        </Grid>
        <TextBlock
            x:Name="Notice"
            Grid.Row="4"
            Margin="0,6,0,4"
            FontSize="11"
            Foreground="{DynamicResource Muted}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <local:ActionDrawer x:Name="ActionsDrawer" Grid.Row="5">
            <Border
                x:Name="ActionBar"
                MinHeight="54"
                Background="{DynamicResource SectionHeaderSurface}"
                BorderBrush="{DynamicResource Line}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ActionAccent" Background="{DynamicResource Line}" CornerRadius="3,0,0,3" />
                    <Grid x:Name="ActionBarGrid" Grid.Column="1" Margin="14,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DockPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <Image x:Name="SelectionIcon" Width="28" Height="28" Margin="0,0,12,0"
                                   Visibility="Collapsed" />
                            <StackPanel>
                                <TextBlock x:Name="SelectionName" FontSize="16" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <TextBlock x:Name="SelectionDetail" Margin="0,2,0,0" FontSize="11"
                                           Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel x:Name="ActionControls" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Orientation="Horizontal">
                            <Button x:Name="Properties" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Info}"
                                    Click="OnProperties" Content="{Binding [Properties], Source={x:Static r:Strings.Text}}"
                                    Style="{DynamicResource ActionBarButton}" />
                            <Button x:Name="CopyDetails" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Copy}"
                                    Click="OnCopyDetails" Content="{Binding [CopyDetails], Source={x:Static r:Strings.Text}}"
                                    Style="{DynamicResource ActionBarButton}" />
                            <Button x:Name="OpenFileLocation" local:ButtonIcon.Data="{x:Static local:ButtonIcon.Folder}"
                                    Click="OnOpenFileLocation" Content="{Binding [OpenFileLocation], Source={x:Static r:Strings.Text}}"
                                    Style="{DynamicResource ActionBarButton}" />
                            <Border Style="{DynamicResource ActionBarDivider}" />
                            <Button x:Name="HideActionsButton" Style="{DynamicResource ActionBarCollapseButton}" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
        </local:ActionDrawer>
    </Grid>
</UserControl>
