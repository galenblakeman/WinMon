<Window x:Class="WinMon.Controls.ProcessAffinityDialog" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShowInTaskbar="False" SizeToContent="WidthAndHeight" MinWidth="380" MinHeight="260" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="AllButton" MinWidth="90" Margin="0,0,8,0"/><Button x:Name="NoneButton" MinWidth="90" Margin="0,0,16,0"/><Button x:Name="OkButton" MinWidth="90" Margin="0,0,8,0" IsDefault="True"/><Button x:Name="CancelButton" MinWidth="90" IsCancel="True"/>
    </WrapPanel>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Processors"/></ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
