<Window x:Class="WinMon.Controls.FlightRecorderSaveDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:WinMon.Resources"
        Title="{Binding [FlightRecorderSave], Source={x:Static r:Strings.Text}}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
        FocusManager.FocusedElement="{Binding ElementName=Range}">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding [FlightRecorderMoment], Source={x:Static r:Strings.Text}}" FontWeight="SemiBold"/>
        <TextBlock x:Name="SelectedMoment" Margin="0,4,0,16" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        <TextBlock x:Name="RangeLabel" Text="{Binding [FlightRecorderSaveRange], Source={x:Static r:Strings.Text}}"
                   Margin="0,0,0,4" FontWeight="SemiBold"/>
        <ComboBox x:Name="Range" AutomationProperties.LabeledBy="{Binding ElementName=RangeLabel}">
            <ComboBoxItem Content="{Binding [FlightRecorderSaveRangeShort], Source={x:Static r:Strings.Text}}"/>
            <ComboBoxItem Content="{Binding [FlightRecorderSaveRangeMedium], Source={x:Static r:Strings.Text}}"/>
            <ComboBoxItem Content="{Binding [FlightRecorderSaveRangeLong], Source={x:Static r:Strings.Text}}"/>
            <ComboBoxItem Content="{Binding [FlightRecorderSaveRangeAll], Source={x:Static r:Strings.Text}}"/>
        </ComboBox>
        <TextBlock x:Name="FileNameLabel" Text="{Binding [ExportFileName], Source={x:Static r:Strings.Text}}"
                   Margin="0,16,0,4" FontWeight="SemiBold"/>
        <TextBox x:Name="FileNameBox" AutomationProperties.LabeledBy="{Binding ElementName=FileNameLabel}"
                 MinHeight="32" Padding="8,4" VerticalContentAlignment="Center"
                 Background="{DynamicResource SearchSurface}" Foreground="{DynamicResource Text}"
                 CaretBrush="{DynamicResource Text}" BorderBrush="{DynamicResource Line}"/>
        <TextBlock Text="{Binding [FlightRecorderSaveLocation], Source={x:Static r:Strings.Text}}"
                   Margin="0,16,0,4" FontWeight="SemiBold"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Click="OnChangeLocation" Margin="8,0,0,0"
                    Content="{Binding [FlightRecorderChangeLocation], Source={x:Static r:Strings.Text}}"/>
            <TextBlock x:Name="LocationPath" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </DockPanel>
        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite"/>
        <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{Binding [Cancel], Source={x:Static r:Strings.Text}}" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="{Binding [Save], Source={x:Static r:Strings.Text}}" IsDefault="True" Click="OnSave"/>
        </WrapPanel>
    </StackPanel>
</Window>
