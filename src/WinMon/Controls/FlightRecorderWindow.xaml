<Window x:Class="WinMon.Controls.FlightRecorderWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinMon.Controls"
        xmlns:r="clr-namespace:WinMon.Resources"
        Title="{Binding [FlightRecorderTitle], Source={x:Static r:Strings.Text}}"
        Width="1000" Height="760" MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="OnKeyDown"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}">
    <Window.Resources>
        <!-- Own the row chrome: the system ListView highlight can be light even in a dark theme. -->
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid>
                            <Border x:Name="Row" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <GridViewRowPresenter x:Name="Columns" Content="{TemplateBinding Content}"
                                                          Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                    <ContentPresenter x:Name="Item" Visibility="Collapsed"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="FocusOutline" BorderBrush="{DynamicResource Text}" BorderThickness="1"
                                    IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding View, RelativeSource={RelativeSource AncestorType=ListView}}" Value="{x:Null}">
                                <Setter TargetName="Columns" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Item" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Raised}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Raised}"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Tab" Padding="12,4" Background="Transparent"
                                        BorderBrush="Transparent" BorderThickness="0,0,0,3">
                                    <ContentPresenter x:Name="HeaderContent" ContentSource="Header" RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Raised}" />
                                        <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        <Setter TargetName="HeaderContent" Property="TextElement.FontWeight" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Text}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

    </Window.Resources>
    <Grid Margin="12" Background="{DynamicResource Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="100" MaxHeight="220"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <Button x:Name="SaveButton" Content="{Binding [FlightRecorderSave], Source={x:Static r:Strings.Text}}"
                        ToolTip="{Binding [FlightRecorderFileHelp], Source={x:Static r:Strings.Text}}" Click="OnSave" Margin="0,0,8,0"/>
                <Button x:Name="OpenButton" Content="{Binding [FlightRecorderOpen], Source={x:Static r:Strings.Text}}"
                        Click="OnOpen" Margin="0,0,8,0"/>
                <Button x:Name="RefreshButton" VerticalAlignment="Top" Margin="0"
                        Content="{Binding [Refresh], Source={x:Static r:Strings.Text}}" Click="OnRefresh"
                        controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.Live}"
                        AutomationProperties.Name="{Binding [Refresh], Source={x:Static r:Strings.Text}}"/>
                </StackPanel>
                <TextBlock Text="{Binding [FlightRecorderTitle], Source={x:Static r:Strings.Text}}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock x:Name="Coverage" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" Margin="0,2,0,2"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <TextBlock x:Name="Source" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       Foreground="{DynamicResource Muted}"/>
            <TabControl x:Name="HistoryMode" SelectionChanged="OnHistoryModeChanged" Margin="0,2,0,2"
                        AutomationProperties.Name="{Binding [FlightRecorderView], Source={x:Static r:Strings.Text}}">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <TabPanel IsItemsHost="True" Background="Transparent"/>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="{Binding [FlightRecorderDetailedHistory], Source={x:Static r:Strings.Text}}"/>
                <TabItem Header="{Binding [FlightRecorderLongerTrends], Source={x:Static r:Strings.Text}}"/>
            </TabControl>
        </StackPanel>
        <WrapPanel x:Name="DetailTools" Grid.Row="1" Margin="0,0,0,4">
            <ComboBox x:Name="Metric" Width="150" Margin="0,0,8,0" SelectionChanged="OnMetricChanged"
                      AutomationProperties.Name="{Binding [FlightRecorderResource], Source={x:Static r:Strings.Text}}"/>
            <Button x:Name="PeakButton" Content="{Binding [FlightRecorderPeak], Source={x:Static r:Strings.Text}}" Click="OnPeak" Margin="0,0,8,0"/>
            <Button x:Name="PreviousButton" Content="{Binding [FlightRecorderPrevious], Source={x:Static r:Strings.Text}}" Click="OnPrevious" Margin="0,0,8,0"/>
            <Button x:Name="NextButton" Content="{Binding [FlightRecorderNext], Source={x:Static r:Strings.Text}}" Click="OnNext"/>
        </WrapPanel>
        <controls:CpuGraph x:Name="Graph" Grid.Row="2" ShowGrid="True" Focusable="True"
                           AutomationProperties.Name="{Binding [FlightRecorderTimeline], Source={x:Static r:Strings.Text}}"/>
        <StackPanel x:Name="DetailSelection" Grid.Row="3" Margin="0,2">
            <TextBlock x:Name="SelectedTime" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding [FlightRecorderAttribution], Source={x:Static r:Strings.Text}}"
                       MaxHeight="34" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"
                       ToolTip="{Binding [FlightRecorderAttribution], Source={x:Static r:Strings.Text}}"/>
            <TextBlock x:Name="SelectedEvent" TextTrimming="CharacterEllipsis" MaxHeight="54" Foreground="{DynamicResource Muted}"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </StackPanel>
        <Grid x:Name="DetailPanels" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HistoryDetailsColumn" Width="2*" MinWidth="240"/>
                <ColumnDefinition x:Name="EventsDividerColumn" Width="10"/>
                <ColumnDefinition x:Name="EventsColumn" Width="*" MinWidth="180"/>
            </Grid.ColumnDefinitions>
        <TabControl x:Name="Views" Grid.Column="0" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}">
            <TabControl.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewColumnHeader">
                                <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}"
                                        BorderThickness="0,0,0,1" Padding="6,4">
                                    <ContentPresenter HorizontalAlignment="Left"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="{Binding [FlightRecorderCompare], Source={x:Static r:Strings.Text}}"
                     ToolTip="{Binding [FlightRecorderComparisonHelp], Source={x:Static r:Strings.Text}}"
                     AutomationProperties.HelpText="{Binding [FlightRecorderComparisonHelp], Source={x:Static r:Strings.Text}}">
                <DockPanel Margin="0,6,0,0">
                    <StackPanel DockPanel.Dock="Top" Margin="6,0,6,6">
                        <TextBlock Text="{Binding [FlightRecorderComparisonCaption], Source={x:Static r:Strings.Text}}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"
                                   ToolTip="{Binding [FlightRecorderComparisonHelp], Source={x:Static r:Strings.Text}}"/>
                        <TextBlock x:Name="ComparisonSummary" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                    <controls:HistoryListView x:Name="ComparisonProcesses" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              AutomationProperties.Name="{Binding [FlightRecorderCompare], Source={x:Static r:Strings.Text}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{Binding [ProcessColumn], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                <GridViewColumn Header="{Binding [CliPid], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Pid}" Width="60"/>
                                <GridViewColumn Header="{Binding [FlightRecorderBefore], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Before}" Width="140"/>
                                <GridViewColumn Header="{Binding [FlightRecorderDuring], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding During}" Width="140"/>
                                <GridViewColumn Header="{Binding [FlightRecorderAfter], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding After}" Width="140"/>
                                <GridViewColumn Header="{Binding [FlightRecorderDelta], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Change}" Width="120"/>
                            </GridView>
                        </ListView.View>
                    </controls:HistoryListView>
                </DockPanel>
            </TabItem>
            <TabItem Header="{Binding [FlightRecorderMoment], Source={x:Static r:Strings.Text}}">
                <DockPanel>
                    <TextBlock x:Name="Readings" DockPanel.Dock="Top" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="6,4"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <controls:HistoryListView x:Name="Processes" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
                              AutomationProperties.Name="{Binding [FlightRecorderContributors], Source={x:Static r:Strings.Text}}">

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{Binding [ProcessColumn], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                <GridViewColumn Header="{Binding [CliPid], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Pid}" Width="70"/>
                                <GridViewColumn Header="{Binding [CPU], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Cpu}" Width="90"/>
                                <GridViewColumn Header="{Binding [Memory], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Memory}" Width="110"/>
                                <GridViewColumn Header="{Binding [IO], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Io}" Width="120"/>
                                <GridViewColumn Header="{Binding [GPU], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Gpu}" Width="90"/>
                                <GridViewColumn Header="{Binding [Network], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Network}" Width="120"/>
                            </GridView>
                        </ListView.View>
                    </controls:HistoryListView>
                </DockPanel>
            </TabItem>
        </TabControl>
        <GridSplitter x:Name="EventsDivider" Grid.Column="1" Width="6" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="{DynamicResource Line}" ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext" DragCompleted="OnEventsResized" KeyUp="OnEventsResizeKeyUp" Focusable="True"
                      AutomationProperties.Name="{Binding [FlightRecorderResizeEvents], Source={x:Static r:Strings.Text}}"/>
        <Grid x:Name="EventsSidebar" Grid.Column="2" Margin="0,6,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel LastChildFill="True">
                <controls:ActivityPanelButton x:Name="EventsToggle" DockPanel.Dock="Left"
                    Margin="8,0" Style="{DynamicResource ActionBarCollapseButton}" Command="{x:Null}" Click="OnToggleEvents"/>
                <TextBlock x:Name="CrashHeading" DockPanel.Dock="Right"
                    Text="{Binding [FlightRecorderCrashes], Source={x:Static r:Strings.Text}}"
                    FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0" Visibility="Collapsed"/>
                <TextBlock x:Name="EventsHeading" Text="{Binding [FlightRecorderEvents], Source={x:Static r:Strings.Text}}"
                    FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
            </DockPanel>
            <StackPanel x:Name="EventsRail" Grid.Row="1" Visibility="Collapsed" Margin="0,8,0,0"
                        ToolTip="{Binding [FlightRecorderEvents], Source={x:Static r:Strings.Text}}">
                <TextBlock x:Name="EventsCount" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                <TextBlock Text="{Binding [FlightRecorderEvents], Source={x:Static r:Strings.Text}}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="{DynamicResource Muted}">
                    <TextBlock.LayoutTransform><RotateTransform Angle="90"/></TextBlock.LayoutTransform>
                </TextBlock>
            </StackPanel>
        <Grid x:Name="EventsBody" Grid.Row="1" Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MaxHeight="60"/>
                <RowDefinition Height="2*" MinHeight="40"/>
            </Grid.RowDefinitions>
            <controls:HistoryListView x:Name="Crashes" Grid.Row="1" MaxHeight="26" Margin="0,0,0,2"
                      Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
                      SelectionChanged="OnCrashSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="{Binding [FlightRecorderCrashes], Source={x:Static r:Strings.Text}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,1" ToolTip="{Binding Summary}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Application}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Application}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Failure}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Failure}" Foreground="{DynamicResource Muted}"/>
                            <TextBlock Grid.Column="2" Text="{Binding CountText}" Margin="4,0,0,0" FontWeight="SemiBold" ToolTip="{Binding Details}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </controls:HistoryListView>
            <TextBlock x:Name="EventCoverageText" Grid.Row="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" Margin="6,0,6,6"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <controls:HistoryListView x:Name="Events" Grid.Row="3" MinHeight="40" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
                      SelectionChanged="OnEventSelected"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      AutomationProperties.Name="{Binding [FlightRecorderEvents], Source={x:Static r:Strings.Text}}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,4">
                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"/>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" Foreground="{DynamicResource Muted}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </controls:HistoryListView>
        </Grid>
        </Grid>
        </Grid>
        <Grid x:Name="TrendSurface" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="160"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <ComboBox x:Name="TrendRange" Width="160" Margin="0,0,8,0" SelectionChanged="OnTrendRangeChanged"
                          AutomationProperties.Name="{Binding [FlightRecorderTrendRange], Source={x:Static r:Strings.Text}}"/>
                <ComboBox x:Name="TrendMetric" Width="180" SelectionChanged="OnTrendMetricChanged"
                          AutomationProperties.Name="{Binding [FlightRecorderResource], Source={x:Static r:Strings.Text}}"/>
            </WrapPanel>
            <TextBlock x:Name="TrendCoverage" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="TrendLegend" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
                <controls:ResourceTrendGraph x:Name="TrendGraph" Grid.Row="1" Focusable="True"
                                             AutomationProperties.Name="{Binding [FlightRecorderLongerTrends], Source={x:Static r:Strings.Text}}"/>
            </Grid>
            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <WrapPanel>
                    <Button x:Name="TrendPrevious" Content="{Binding [FlightRecorderPrevious], Source={x:Static r:Strings.Text}}" Click="OnTrendPrevious" Margin="0,0,8,0"/>
                    <Button x:Name="TrendNext" Content="{Binding [FlightRecorderNext], Source={x:Static r:Strings.Text}}" Click="OnTrendNext" Margin="0,0,8,0"/>
                    <Button x:Name="OpenTrendDetail" Content="{Binding [FlightRecorderOpenDetailed], Source={x:Static r:Strings.Text}}" Click="OnOpenTrendDetail"/>
                </WrapPanel>
                <TextBlock x:Name="TrendSelection" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
        <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <Button Content="{Binding [Close], Source={x:Static r:Strings.Text}}" IsCancel="True" Click="OnClose" DockPanel.Dock="Right" Margin="12,0,0,0"/>
            <TextBox x:Name="Changes" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100"
                     VerticalScrollBarVisibility="Auto" BorderThickness="0"
                     Background="{DynamicResource Surface}" Foreground="{DynamicResource Muted}"
                     AutomationProperties.Name="{Binding [FlightRecorderChanges], Source={x:Static r:Strings.Text}}"/>
        </DockPanel>
    </Grid>
</Window>
