<Window x:Class="WinMon.Controls.FlightRecorderWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinMon.Controls"
        xmlns:r="clr-namespace:WinMon.Resources"
        Title="{Binding [FlightRecorderTitle], Source={x:Static r:Strings.Text}}"
        Width="1000" Height="760" MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="OnKeyDown"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="100" MaxHeight="220"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <DockPanel>
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"
                        Content="{Binding [Refresh], Source={x:Static r:Strings.Text}}" Click="OnRefresh"
                        controls:ButtonIcon.Data="{x:Static controls:ButtonIcon.Live}"
                        AutomationProperties.Name="{Binding [Refresh], Source={x:Static r:Strings.Text}}"/>
                <TextBlock Text="{Binding [FlightRecorderTitle], Source={x:Static r:Strings.Text}}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock x:Name="Coverage" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,10"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ComboBox x:Name="Metric" Width="150" Margin="0,0,8,0" SelectionChanged="OnMetricChanged"
                      AutomationProperties.Name="{Binding [FlightRecorderResource], Source={x:Static r:Strings.Text}}"/>
            <Button x:Name="PeakButton" Content="{Binding [FlightRecorderPeak], Source={x:Static r:Strings.Text}}" Click="OnPeak" Margin="0,0,8,0"/>
            <Button x:Name="PreviousButton" Content="{Binding [FlightRecorderPrevious], Source={x:Static r:Strings.Text}}" Click="OnPrevious" Margin="0,0,8,0"/>
            <Button x:Name="NextButton" Content="{Binding [FlightRecorderNext], Source={x:Static r:Strings.Text}}" Click="OnNext"/>
        </WrapPanel>
        <controls:CpuGraph x:Name="Graph" Grid.Row="2" ShowGrid="True" Focusable="True"
                           AutomationProperties.Name="{Binding [FlightRecorderTimeline], Source={x:Static r:Strings.Text}}"/>
        <StackPanel Grid.Row="3" Margin="0,8">
            <TextBlock x:Name="SelectedTime" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding [FlightRecorderAttribution], Source={x:Static r:Strings.Text}}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
        </StackPanel>
        <TabControl x:Name="Views" Grid.Row="4" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Tab" Padding="12,6" Background="Transparent"
                                        BorderBrush="Transparent" BorderThickness="0,0,0,3">
                                    <ContentPresenter x:Name="HeaderContent" ContentSource="Header" RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Raised}" />
                                        <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        <Setter TargetName="HeaderContent" Property="TextElement.FontWeight" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Text}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewColumnHeader">
                                <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}"
                                        BorderThickness="0,0,0,1" Padding="6,4">
                                    <ContentPresenter HorizontalAlignment="Left"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="{Binding [FlightRecorderCompare], Source={x:Static r:Strings.Text}}"
                     ToolTip="{Binding [FlightRecorderComparisonHelp], Source={x:Static r:Strings.Text}}"
                     AutomationProperties.HelpText="{Binding [FlightRecorderComparisonHelp], Source={x:Static r:Strings.Text}}">
                <DockPanel Margin="0,6,0,0">
                    <StackPanel DockPanel.Dock="Top" Margin="6,0,6,6">
                        <TextBlock Text="{Binding [FlightRecorderComparisonCaption], Source={x:Static r:Strings.Text}}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                   ToolTip="{Binding [FlightRecorderComparisonHelp], Source={x:Static r:Strings.Text}}"/>
                        <TextBlock x:Name="ComparisonSummary" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <ListView x:Name="ComparisonProcesses" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              AutomationProperties.Name="{Binding [FlightRecorderCompare], Source={x:Static r:Strings.Text}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{Binding [ProcessColumn], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                <GridViewColumn Header="{Binding [CliPid], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Pid}" Width="60"/>
                                <GridViewColumn Header="{Binding [FlightRecorderBefore], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Before}" Width="140"/>
                                <GridViewColumn Header="{Binding [FlightRecorderDuring], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding During}" Width="140"/>
                                <GridViewColumn Header="{Binding [FlightRecorderAfter], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding After}" Width="140"/>
                                <GridViewColumn Header="{Binding [FlightRecorderDelta], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Change}" Width="120"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
            <TabItem Header="{Binding [FlightRecorderMoment], Source={x:Static r:Strings.Text}}">
                <DockPanel>
                    <TextBlock x:Name="Readings" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="6,4"/>
                    <ListView x:Name="Processes" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
                              AutomationProperties.Name="{Binding [FlightRecorderContributors], Source={x:Static r:Strings.Text}}">

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{Binding [ProcessColumn], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                <GridViewColumn Header="{Binding [CliPid], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Pid}" Width="70"/>
                                <GridViewColumn Header="{Binding [CPU], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Cpu}" Width="90"/>
                                <GridViewColumn Header="{Binding [Memory], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Memory}" Width="110"/>
                                <GridViewColumn Header="{Binding [IO], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Io}" Width="120"/>
                                <GridViewColumn Header="{Binding [GPU], Source={x:Static r:Strings.Text}}" DisplayMemberBinding="{Binding Gpu}" Width="90"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <Button Content="{Binding [Close], Source={x:Static r:Strings.Text}}" IsCancel="True" Click="OnClose" DockPanel.Dock="Right" Margin="12,0,0,0"/>
            <TextBox x:Name="Changes" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100"
                     VerticalScrollBarVisibility="Auto" BorderThickness="0"
                     Background="{DynamicResource Surface}" Foreground="{DynamicResource Muted}"
                     AutomationProperties.Name="{Binding [FlightRecorderChanges], Source={x:Static r:Strings.Text}}"/>
        </DockPanel>
    </Grid>
</Window>
