<Project>
  <!-- Product metadata shared by every project. Bump Version for each release; app.manifest carries the same number. -->
  <PropertyGroup>
    <Version>1.0.3</Version>
    <Product>WinMon</Product>
    <Authors>Galen Blakeman</Authors>
    <Company>Galen Blakeman</Company>
    <Copyright>Copyright © 2026 Galen Blakeman</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/galenblakeman/WinMon</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Show the version exactly as written, without the SDK's +commit suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
